---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="第一屆臺灣青少年科學發展論壇">
	<div class="forum-hero">
		<canvas id="particle-canvas" class="particle-canvas"></canvas>
		<div class="forum-hero-inner">
			<p class="forum-hero-label anim-item anim-1">第一屆</p>
			<div id="title-hitbox" class="title-hitbox"></div>
			<p class="forum-hero-date anim-item anim-3">2026年12月25日（五）－12月26日（六）・國立臺灣科學教育館</p>
			<p class="forum-hero-organizer anim-item anim-3">主辦單位：臺灣青少年科學發展協會、國立臺灣科學教育館</p>
			<div class="quick-links">
				<a href="/forum/2026/speakers" class="quick-link anim-item anim-4">講者陣容</a>
				<a href="/forum/2026/schedule" class="quick-link anim-item anim-5">議程時間表</a>
				<a href="/forum/2026/register" class="quick-link register anim-item anim-6">立即報名</a>
				<a href="/about" class="quick-link anim-item anim-6">聯絡我們</a>
			</div>
		</div>
	</div>

	<style>
		.forum-hero {
			position: relative;
			width: 100%;
			height: calc(100svh - var(--header-h));
			display: flex;
			align-items: center;
			justify-content: center;
			background:
				linear-gradient(rgba(20, 24, 26, 0.75), rgba(20, 24, 26, 0.85)),
				url('/RRRRR.png');
			background-size: cover;
			background-position: center;
			padding: 1.5rem 2rem clamp(2rem, 6vh, 4rem);
			box-sizing: border-box;
			overflow: hidden;
			text-align: center;
		}
		.particle-canvas {
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			pointer-events: none;
		}
		.forum-hero-inner {
			max-width: 800px;
			margin: 0 auto;
			width: 100%;
			box-sizing: border-box;
			position: relative;
			display: flex;
			flex-direction: column;
			align-items: center;
		}
		.forum-hero-label {
			display: inline-block;
			background: rgba(212, 184, 118, 0.15);
			border: 1px solid rgba(212, 184, 118, 0.4);
			color: #D4B876;
			font-weight: 700;
			font-size: 0.8rem;
			letter-spacing: 0.15em;
			padding: 0.3rem 1rem;
			border-radius: 999px;
			margin: 0 0 clamp(0.75rem, 2vh, 1.25rem);
			backdrop-filter: blur(6px);
			flex-shrink: 0;
		}
		.title-hitbox {
			width: 100%;
			height: clamp(4.5rem, 18vh, 9rem);
			margin: 0 0 clamp(0.5rem, 2vh, 1rem);
			flex-shrink: 0;
		}
		.forum-hero-date {
			color: #A8ACBA;
			font-size: 1rem;
			margin: 0 0 clamp(0.4rem, 1.2vh, 0.6rem);
			flex-shrink: 0;
		}
		.forum-hero-organizer {
			color: #7C8090;
			font-size: 0.85rem;
			margin: 0 0 clamp(1rem, 3vh, 1.75rem);
			flex-shrink: 0;
		}
		.quick-links {
			display: flex;
			gap: 1.25rem;
			flex-wrap: wrap;
			justify-content: center;
			margin-bottom: 0;
			flex-shrink: 0;
		}
		.quick-link {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-width: 9.5rem;
			padding: clamp(0.6rem, 2vh, 1rem) 1.5rem;
			border-radius: 12px;
			background: rgba(255,255,255,0.04);
			color: #E8E9ED;
			text-decoration: none;
			font-weight: 700;
			font-size: 1rem;
			text-align: center;
			box-sizing: border-box;
			border: 1px solid rgba(255,255,255,0.18);
			backdrop-filter: blur(6px);
			transition: box-shadow 0.25s ease, transform 0.2s ease, border-color 0.25s ease;
		}
		.quick-link:hover {
			border-color: rgba(255,255,255,0.35);
			transform: translateY(-2px);
		}
		.quick-link.register {
			background: #D4B876;
			color: #14181A;
			border: 1px solid #D4B876;
			box-shadow: 0 0 20px rgba(212, 184, 118, 0.5), 0 0 40px rgba(212, 184, 118, 0.25);
		}
		.quick-link.register:hover {
			box-shadow: 0 0 28px rgba(212, 184, 118, 0.7), 0 0 56px rgba(212, 184, 118, 0.35);
			opacity: 1;
		}

		.anim-item {
			opacity: 0;
			transform: translateY(20px);
			animation: fadeUp 0.7s ease forwards;
		}
		.anim-1 { animation-delay: 0.1s; }
		.anim-3 { animation-delay: 1.6s; }
		.anim-4 { animation-delay: 1.8s; }
		.anim-5 { animation-delay: 1.9s; }
		.anim-6 { animation-delay: 2s; }

		@keyframes fadeUp {
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		@media (max-width: 700px) {
			.forum-hero {
				padding: 1rem 1.5rem 3rem;
			}
			.title-hitbox {
				height: 8rem;
			}
			.forum-hero-date {
				font-size: 0.9rem;
			}
			.forum-hero-organizer {
				font-size: 0.75rem;
			}
			.quick-link {
				min-width: 8rem;
				padding: 0.8rem 1.2rem;
				font-size: 0.9rem;
			}
		}
	</style>

	<script>
		const footer = document.querySelector('footer');
		if (footer) {
			footer.style.display = 'none';
		}

		const canvas = document.getElementById('particle-canvas');
		const titleHitbox = document.getElementById('title-hitbox');
		const ctx = canvas.getContext('2d');
		const hero = canvas.closest('.forum-hero');
		const PARTICLE_COLOR = '#6FBF98';
		const TITLE_TEXT = '臺灣青少年科學發展論壇';
		const TITLE_LINES_MOBILE = ['臺灣青少年', '科學發展論壇'];
		const TITLE_FONT_WEIGHT = 500;
		const REPEL_RADIUS = 40;
		const REPEL_STRENGTH = 22;
		const PARTICLE_GAP = 1.6;
		const PARTICLE_SIZE = 1.6;
		const EASE_AWAY = 0.50;
		const EASE_RETURN = 0.1;
		const INTRO_SCATTER_MARGIN = 0.7;

		let mouseX = -9999;
		let mouseY = -9999;

		function resizeCanvas() {
			canvas.width = hero.offsetWidth;
			canvas.height = hero.offsetHeight;
		}
		resizeCanvas();
		window.addEventListener('resize', resizeCanvas);

		function buildTextPoints() {
			const boxRect = titleHitbox.getBoundingClientRect();
			const heroRect = hero.getBoundingClientRect();
			const offsetX = boxRect.left - heroRect.left;
			const offsetY = boxRect.top - heroRect.top;
			const boxW = boxRect.width;
			const boxH = boxRect.height;

			const isMobile = boxW < 500;

			const offCanvas = document.createElement('canvas');
			offCanvas.width = canvas.width;
			offCanvas.height = canvas.height;
			const offCtx = offCanvas.getContext('2d');
			offCtx.fillStyle = '#fff';
			offCtx.textAlign = 'center';
			offCtx.textBaseline = 'middle';

			if (isMobile) {
				const lineCount = TITLE_LINES_MOBILE.length;
				const fontSize = boxH * 0.34;
				const lineHeight = boxH / lineCount;

				TITLE_LINES_MOBILE.forEach((line, i) => {
					offCtx.font = `${TITLE_FONT_WEIGHT} ${fontSize}px system-ui, sans-serif`;
					const lineCenterY = offsetY + lineHeight * i + lineHeight / 2;
					offCtx.fillText(line, offsetX + boxW / 2, lineCenterY);
				});
			} else {
				const fontSize = boxH * 0.8;
				offCtx.font = `${TITLE_FONT_WEIGHT} ${fontSize}px system-ui, sans-serif`;
				offCtx.fillText(TITLE_TEXT, offsetX + boxW / 2, offsetY + boxH / 2);
			}

			const imageData = offCtx.getImageData(0, 0, offCanvas.width, offCanvas.height);
			const points = [];

			for (let y = 0; y < offCanvas.height; y += PARTICLE_GAP) {
				for (let x = 0; x < offCanvas.width; x += PARTICLE_GAP) {
					const idx = (Math.floor(y) * offCanvas.width + Math.floor(x)) * 4;
					if (imageData.data[idx + 3] > 128) {
						points.push({ x, y });
					}
				}
			}
			return points;
		}

		let particles = [];

		function initParticles() {
			const points = buildTextPoints();
			particles = points.map((pt) => ({
				homeX: pt.x,
				homeY: pt.y,
				x: Math.random() * canvas.width,
				y: Math.random() * canvas.height
			}));
		}

		function randomScatterPos(dim) {
			// 範圍擴大到超出畫布邊界，讓粒子從更遠的地方飄進來，避免矩形邊框收合的視覺感
			return (Math.random() * (1 + INTRO_SCATTER_MARGIN * 2) - INTRO_SCATTER_MARGIN) * dim;
		}

		function drawLoop() {
			ctx.clearRect(0, 0, canvas.width, canvas.height);
			ctx.fillStyle = PARTICLE_COLOR;

			particles.forEach((p) => {
				const dx = p.x - mouseX;
				const dy = p.y - mouseY;
				const dist = Math.sqrt(dx * dx + dy * dy);

				let targetX = p.homeX;
				let targetY = p.homeY;
				let isRepelled = false;

				if (dist < REPEL_RADIUS) {
					const force = (1 - dist / REPEL_RADIUS) * REPEL_STRENGTH;
					const angle = Math.atan2(dy, dx) || Math.random() * Math.PI * 2;
					targetX = p.homeX + Math.cos(angle) * force * 3;
					targetY = p.homeY + Math.sin(angle) * force * 3;
					isRepelled = true;
				}

				const ease = isRepelled ? EASE_AWAY : EASE_RETURN;
				p.x += (targetX - p.x) * ease;
				p.y += (targetY - p.y) * ease;

				ctx.fillRect(p.x, p.y, PARTICLE_SIZE, PARTICLE_SIZE);
			});

			requestAnimationFrame(drawLoop);
		}

		function playIntro() {
			initParticles();

			let frame = 0;
			const totalFrames = 80;

			particles.forEach((p) => {
				p.x = randomScatterPos(canvas.width);
				p.y = randomScatterPos(canvas.height);
			});

			function animateIntro() {
				ctx.clearRect(0, 0, canvas.width, canvas.height);
				frame++;
				const progress = Math.min(frame / totalFrames, 1);
				const ease = 1 - Math.pow(1 - progress, 3);

				ctx.fillStyle = PARTICLE_COLOR;
				particles.forEach((p) => {
					p.x = p.x + (p.homeX - p.x) * ease * 0.3;
					p.y = p.y + (p.homeY - p.y) * ease * 0.3;
					ctx.fillRect(p.x, p.y, PARTICLE_SIZE, PARTICLE_SIZE);
				});

				if (progress < 1) {
					requestAnimationFrame(animateIntro);
				} else {
					particles.forEach((p) => {
						p.x = p.homeX;
						p.y = p.homeY;
					});
					requestAnimationFrame(drawLoop);
				}
			}
			requestAnimationFrame(animateIntro);
		}

		hero.addEventListener('mousemove', (e) => {
			const rect = hero.getBoundingClientRect();
			mouseX = e.clientX - rect.left;
			mouseY = e.clientY - rect.top;
		});
		hero.addEventListener('mouseleave', () => {
			mouseX = -9999;
			mouseY = -9999;
		});

		window.addEventListener('load', () => {
			setTimeout(playIntro, 200);
		});
		window.addEventListener('resize', () => {
			resizeCanvas();
			initParticles();
		});
	</script>
</Layout>
