---
import Layout from '../../../../layouts/Layout.astro';
import { getLangFromUrl, localizePath } from '../../../../i18n/ui';
import { speakerEnName } from '../../../../i18n/people';

export function getStaticPaths() {
	return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}

const lang = getLangFromUrl(Astro.url);

const t = {
	zh: {
		layoutTitle: '講者陣容 | 第一屆臺灣青少年科學發展論壇',
		back: '返回論壇詳情',
		sectionLabel: '講者陣容',
		swipeHint: '左右滑動切換講者・點擊上方切換論壇',
		nthSpeaker: (n: number) => `第 ${n} 位講者`
	},
	en: {
		layoutTitle: 'Speakers | The 1st Taiwan Young Science Development Forum',
		back: 'Back to forum details',
		sectionLabel: 'Speakers',
		swipeHint: 'Swipe left or right to change speakers · Tap above to switch forums',
		nthSpeaker: (n: number) => `Speaker ${n}`
	}
}[lang];

const rawGroups = [
	{
		label: { zh: "論壇一", en: "Forum 1" },
		theme: { zh: "青年科學家論壇", en: "Young Scientists Forum" },
		speakers: [
			{
				name: "謝至亮",
				title: {
					zh: "當閃光燈快到能看見電子？站在諾獎巨人們的肩上走科研之路",
					en: "When the Flash Gets Fast Enough to See Electrons? Walking the Research Path on the Shoulders of Nobel Giants"
				},
				bio: {
					zh: "世界上最快的「閃光燈」，究竟能拍下什麼？從熟悉的相機閃光燈出發，我們將一路把光的時間尺度壓縮：從毫秒、微秒、奈秒、皮秒，到飛秒、甚至阿秒。這條路上，不僅誕生了改變現代科技的雷射與超快光學，也留下多項諾貝爾獎的精彩故事。而這也是我的科研旅程：從台灣交大碩士班的飛秒顯微術，到瑞士洛桑理工學院(EPFL)研究飛秒光與物質的非線性交互作用，以及讓光進行 AI 運算；如今，我在德國 attoworld 實驗室探索阿秒尺度的超快現象與應用。",
					en: "What could the world's fastest “flash” possibly capture? Starting from the familiar camera flash, we compress the timescale of light step by step: from milliseconds, microseconds, nanoseconds and picoseconds to femtoseconds and even attoseconds. Along this road were born the lasers and ultrafast optics that reshaped modern technology, together with the stories behind several Nobel Prizes. It is also the story of my own research journey: from femtosecond microscopy in my master's program at National Chiao Tung University in Taiwan, to nonlinear interactions between femtosecond light and matter at EPFL in Switzerland, and to making light perform AI computation. Today, at the attoworld laboratory in Germany, I explore ultrafast phenomena and applications on the attosecond scale."
				},
				photo: "/speaker-xie-zhiliang.jpg"
			},
			{
				name: "尉遲和妘",
				link: "https://hoyunyuchih.github.io/#intro",
				title: { zh: "黑洞能量提取與磁重聯", en: "Black Hole Energy Extraction and Magnetic Reconnection" },
				bio: {
					zh: "我畢業於崑山杜克大學，我最近的研究有關於黑洞。黑洞過往被認為是時空與信息的終點，然而隨著物理學家們的狂想與理論的發展，發現黑洞其實並非完全「只進不出」——自旋黑洞蘊藏的能量，有一部分是可以被合理提取出來的。磁重聯是磁化電漿中很常見的現象，從太陽閃焰到黑洞周圍的吸積流都看得到；而我的研究，正是探討這個現象在黑洞能量提取問題中，扮演什麼樣的角色。我目前最新的研究正將這套方法推廣到更一般的黑洞時空，檢驗當重力理論偏離廣義相對論時，對於黑洞的能量提取效率會如何改變。",
					en: "I graduated from Duke Kunshan University, and my recent research concerns black holes. Black holes were long regarded as the end point of spacetime and information. As physicists' bold ideas and theories developed, however, it turned out that black holes are not strictly “one-way”: part of the energy stored in a spinning black hole can be extracted in a physically consistent way. Magnetic reconnection is a common phenomenon in magnetized plasmas, seen everywhere from solar flares to accretion flows around black holes, and my research examines what role it plays in black hole energy extraction. My latest work extends this approach to more general black hole spacetimes, testing how the energy extraction efficiency changes when the theory of gravity deviates from general relativity."
				},
				photo: "/speaker-yuchih-hoyun.jpg"
			},
			{
				name: "王翊語",
				title: { zh: "跨領域的科學探索之路", en: "A Cross-disciplinary Path of Scientific Exploration" },
				bio: {
					zh: "國中小的科展是我對自然科學的啟蒙，後來幾個夏天在台灣野鳥協會做志工、高中接觸數學建模，這些培養了我探索不同領域的好奇心。大學時，我從資工的角度在中研院生物多樣性中心實習，後來以電腦模擬分析白蟻彈性大顎力學效能的大專學生計畫。除了資工系的分散式系統研究，我也因對後量子密碼學的興趣，再次進入中研院實習。一路輾轉不同學科後，我最後選擇在倫敦成為一名軟體工程師。雖然沒有走上學術研究，但這些科學探索帶給我的好奇、觀察與批判思考，至今仍深深影響我。",
					en: "Science fairs in primary and middle school were my introduction to the natural sciences. Several summers volunteering at a wild bird association in Taiwan and mathematical modeling in high school then built my curiosity for exploring different fields. At university I interned at the Biodiversity Research Center, Academia Sinica, from a computer science perspective, and later joined a student research project that used computer simulation to analyze the mechanical performance of termite elastic mandibles. Besides distributed-systems research in my CS department, my interest in post-quantum cryptography took me back to Academia Sinica for another internship. After moving through several disciplines, I chose to become a software engineer in London. Although I did not pursue an academic career, the curiosity, observation and critical thinking these scientific explorations gave me still shape me deeply."
				},
				photo: "/speaker-wang-yiyu.jpg"
			}
		]
	},
	{
		label: { zh: "論壇二", en: "Forum 2" },
		theme: { zh: "大學科學參與論壇", en: "University Science Engagement Forum" },
		speakers: [
			{
				name: "徐士展",
				title: { zh: "同樣的豉甲，不同的問題", en: "The Same Whirligig Beetle, Different Questions" },
				bio: {
					zh: "從國小第一次接觸豉甲，到高中重新以物理的角度研究牠快速下潛的原因，我逐漸體會到，科學研究並不是一開始就要有多厲害的題目，而是從好奇、觀察與一個個問題慢慢累積而來。隨著學習力學、3D 建模與流體分析，我開始能將單純的現象轉化成假說，再透過模型與實驗驗證。這次分享希望從自己的成長經驗出發，談談哪些學習、環境與選擇能幫助青少年把好奇真正變成研究，以及在 AI 時代中，如何保有判斷與驗證答案的能力。",
					en: "From my first encounter with whirligig beetles in primary school to revisiting, in high school, why they dive so fast from a physics perspective, I gradually came to appreciate that scientific research does not need an impressive topic at the start; it accumulates slowly from curiosity, observation and one question after another. As I learned mechanics, 3D modeling and fluid analysis, I began to turn plain phenomena into hypotheses and then test them with models and experiments. In this talk I hope to start from my own growth and discuss which kinds of learning, environments and choices help young people turn curiosity into real research, and how to keep the ability to judge and verify answers in the age of AI."
				},
				photo: "/speaker-xu-shizhan.jpg"
			},
			{
				name: "許禾臻",
				title: {
					zh: "高中：蚤蠅的高頻率間歇性運動之探討｜大學：未定",
					en: "High school: High-Frequency Intermittent Locomotion of Phorid Flies | University: undecided"
				},
				bio: {
					zh: "目前就讀國立臺灣大學牙醫學系三年級，高中就讀彰化高中科學班。受科學班課程規劃影響，我於高二開始接觸科學研究，因對物理與生物感興趣，進入中興大學生物力學實驗室，研究蚤蠅的高頻率間歇性運動。進入大學後，我因研究導論課接觸牙周幹細胞，並結合自身十字韌帶受傷的經驗，開始思考牙周幹細胞應用於韌帶修復的可能性，也由此踏上新的研究歷程。",
					en: "I am currently a third-year student in the Department of Dentistry at National Taiwan University, and attended the Science Class at Changhua Senior High School. Shaped by the Science Class curriculum, I began scientific research in my second year of high school; out of interest in physics and biology, I joined a biomechanics laboratory at National Chung Hsing University to study the high-frequency intermittent locomotion of phorid flies. At university, an introductory research course introduced me to periodontal stem cells; combined with my own experience of a cruciate ligament injury, I began to consider whether periodontal stem cells could be applied to ligament repair, and so started a new research journey."
				},
				photo: "/speaker-xu-hezhen.jpg"
			},
			{
				name: "張雨恩",
				title: {
					zh: "純爪抓附的意外多樣性：白蟻爪形態、抓附力與生態適應之力學分析",
					en: "The Unexpected Diversity of Claw-only Attachment: A Mechanical Analysis of Termite Claw Morphology, Attachment Force and Ecological Adaptation"
				},
				bio: {
					zh: "目前就讀陽明交通大學百川學程。高中時因為對物理與生物的興趣而投入生物力學研究，從白蟻在不同粗糙表面的抓附表現出發，延伸到物種、形態與行為等方面。進入百川不分系後，我仍持續投入科學研究，同時開始接觸程式軟體設計，在跨領域的環境中慢慢形塑自己的未來走向。對我而言，基礎科學不只是高中階段的研究，更是促使我持續探索興趣與增進能力、結合不同領域的起點。",
					en: "I am currently enrolled in the Bai-Chuan Program (an undeclared-major program) at National Yang Ming Chiao Tung University. In high school, my interest in physics and biology led me into biomechanics research; starting from how termites grip rough surfaces of different kinds, I extended the work to species, morphology and behavior. After entering the Bai-Chuan program, I kept doing scientific research while also starting to study software design, gradually shaping my future direction in an interdisciplinary environment. For me, basic science is not just high school research but the starting point that keeps me exploring my interests, building my abilities and combining different fields."
				},
				photo: "/speaker-zhang-yuen.jpg"
			}
		]
	},
	{
		label: { zh: "論壇三", en: "Forum 3" },
		theme: { zh: "高中老師科學發展論壇", en: "High School Teachers' Science Development Forum" },
		speakers: [
			{
				name: "蔡任圃",
				title: {
					zh: "北一女中老師・生物學學理解碼運動發起人",
					en: "Teacher at Taipei First Girls' High School · Founder of the Biology Concept Decoding Movement"
				},
				bio: {
					zh: "蔡任圃老師（人稱「艦長」）現任教於北一女中，榮獲教育部師鐸獎、臺北市特殊優良教師、多次獲得中小學科展與旺宏科學獎優良指導老師等殊榮，出版《生物學學理解碼》系列與《動手做科學探究》等書，並登上TEDx Talks舞台。艦長長年深耕中學生物教育與科學研究，創立「動物行為與生理學實驗室（蟑螂實驗室）」，指導學生深入探討昆蟲多種行為與生理的研究主題，引領高中生動手探索生物學與跨科議題的奧秘。\n\n為打破傳統死背的學習盲點，艦長於2014年發起「生物學學理解碼運動」，長期推動教師專業成長工作坊，並透過生物學概念解碼、科普影片的製作與實作教具研發，將深奧的學術文獻化為清晰易懂的科學探究教材。無論是引領學子踏上獨立研究與科展之路，或是協助教師精進探究與實作教學，艦長始終以熱情與嚴謹並重的態度，點燃無數年輕學子對生命科學的熱情，是引領臺灣高中科學教育創新與深化的重要推手。",
					en: "Jen-Pu Tsai (known as “Captain”) teaches at Taipei First Girls' High School. Captain has received the Ministry of Education's Shi-Duo Award and the Taipei City Special Outstanding Teacher Award, has repeatedly advised award-winning science fair and Macronix Science Award projects, has published the Biology Concept Decoding series (《生物學學理解碼》) and Hands-on Science Inquiry (《動手做科學探究》), and has given a TEDx talk. Captain founded the “Cockroach Lab” (Animal Behavior and Physiology Laboratory) and launched the “Biology Concept Decoding Movement” in 2014, turning dense literature into accessible inquiry materials for students and teachers."
				},
				photo: "/speaker-cai-renpu.jpg"
			},
			{
				name: "龔雍任",
				link: "https://www.youtube.com/channel/UCEuGes9WGQPa1bY-xnPrDag",
				title: {
					zh: "臺中一中老師・公鴿生物小講堂作者",
					en: "Teacher at National Taichung First Senior High School · Creator of the 公鴿生物小講堂 channel"
				},
				bio: {
					zh: "龔雍任老師現任教於臺中一中，曾榮獲杏壇芬芳獎、臺中市師鐸獎，目前擔任臺中一中科學班班主任以及彰師大生物系兼任助理教授，並於大學開授「生物實驗教學法」、「生物科教學應用與實作」與「生物科教材教法」等課程。\n\n在臺中一中任教期間共指導四屆科學班與一屆資優班學生進行專題研究，曾多次獲得國際科展、全國科展、旺宏科學獎、全國能力競賽獎項，指導經驗豐富。龔老師熱愛帶領學生進行科學研究，並協助臺中一中開設校訂必修「數理研究法」課程，透過系統性課程讓學生無痛獲得研究的技能，目前致力於指導更多台灣未來的生物老師，以及維護「公鴿生物小講堂」頻道，為台灣科學教育盡一份心力。",
					en: "Teacher Kung teaches at National Taichung First Senior High School and has received the Xingtan Fenfang Award and the Taichung City Shiduo Award. Kung is head teacher of the school’s Science Program and an adjunct assistant professor of biology at National Changhua University of Education. Kung has supervised four cohorts of Science Program students and one gifted class, with awards from international and national science fairs and the Macronix Science Awards, and now focuses on training future biology teachers and running the “公鴿生物小講堂” channel."
				},
				photo: "/speaker-gong-yongren.jpg"
			}
		]
	},
	{
		label: { zh: "論壇四", en: "Forum 4" },
		theme: { zh: "大學老師科學發展論壇", en: "University Faculty Science Development Forum" },
		speakers: [
			{
				name: "紀凱容",
				link: "https://www.phys.nchu.edu.tw/member/ins.php?index_m1_id=4&index_id=48",
				title: { zh: "比較生物力學・功能形態學・仿生科學", en: "Comparative Biomechanics · Functional Morphology · Biomimetic Science" },
				bio: {
					zh: "為什麼白蟻的大顎能彈出動物運動的最快紀錄？為什麼跳蛛能在空中迅速平衡？為什麼雄性龍蝨的附著毛能抵抗快速甩動？哺乳動物越大，掌墊只增加面積就行了嗎？紀凱容老師從這些生物的構造與行為出發，用力學來解釋「長成這樣」與「這樣動」的關係。老師是美國杜克大學動物學博士，任教於國立中興大學物理學系，並合聘於生命科學系。這些年帶領數十位學生探索陸、水、空各域生物適應的力學法則，也長期陪高中生做研究，成果獲得許多獎項肯定。雖以老師為職，但自認是生物力學的終身學徒。\n\n老師多年來持續推動比較生物力學的跨領域研究交流與科學教育，團隊經營「ICBM生物力學觀」，並與「科學漫畫工作室」合作，將科學論文「創譯」為趣味橫生的圖文故事。",
					en: "Why can a termite’s mandible snap with the fastest movement recorded in any animal? Professor Chi uses mechanics to explain how animals are built and why they move the way they do. Professor Chi holds a Ph.D. in Zoology from Duke University, teaches in the Department of Physics at National Chung Hsing University with a joint appointment in Life Sciences, and has led dozens of students in studying how organisms adapt on land, in water and in the air. Professor Chi also mentors high school researchers, and the team runs “ICBM” (生物力學觀), working with the Science Comics Studio to “creatively translate” papers into illustrated stories."
				},
				photo: "/speaker-ji-kairong.jpg"
			},
			{
				name: "李後鋒",
				link: "https://www.entomol.nchu.edu.tw/?aid=82&pid=86",
				title: { zh: "都市昆蟲學・白蟻生物學與防治", en: "Urban Entomology · Termite Biology and Control" },
				bio: {
					zh: "白蟻怎麼住進人的房子，又該怎麼請牠們搬走？李後鋒老師研究的是城市裡的昆蟲，尤其是白蟻的生物學與防治。老師是美國佛羅里達大學昆蟲學暨線蟲學博士，在國立中興大學昆蟲學系任教，主持都市昆蟲學研究室，也教科學研究方法。這些年帶過數十個大專生的研究計畫，老師和學生都拿過創新獎，也長期陪高中生做研究。",
					en: "How do termites end up in our buildings, and how do we get them to leave? Professor Lee studies insects in cities, especially termite biology and control. Professor Lee holds a Ph.D. in Entomology and Nematology from the University of Florida, teaches in the Department of Entomology at National Chung Hsing University, leads the Urban Entomology Laboratory, and teaches scientific research methods. Over the years Professor Lee has supervised dozens of undergraduate research projects, won innovation awards together with students, and has long worked with high school students on research."
				},
				photo: "/speaker-li-houfeng.jpg"
			}
		]
	},
	{
		label: { zh: "論壇五", en: "Forum 5" },
		theme: { zh: "科教論壇", en: "Science Education Forum" },
		speakers: [
			{
				name: "鄭夢慈",
				link: "https://biology.ncue.edu.tw/front/Members/member.php?ID=bmN1ZV9iaW9sb2d5Jk1lbWJlcnM=&PID=62",
				title: { zh: "教授・科教論壇", en: "Professor · Science Education Forum" },
				bio: {
					zh: "學生玩一場遊戲，能不能真的搞懂免疫系統怎麼運作？鄭夢慈老師研究的就是這件事：把科學概念放進遊戲裡，看人在遊戲中怎麼學、學到了什麼。老師在國立彰化師範大學生物學系任教，主持生物多媒體教育實驗室，台大植物系學士、師大生物系碩士，北卡羅來納州立大學科學教育博士，研究圍繞科學教育、教學遊戲與網路學習，並取得「人體免疫教學裝置」與「演化學習遊戲裝置」兩項專利。",
					en: "Can playing a game actually teach students how the immune system works? That is the question Professor Cheng studies: putting scientific concepts inside games, and watching how people learn from them and what they take away. Professor Cheng teaches in the Department of Biology at National Changhua University of Education and leads the Biology Multimedia Education Laboratory, with a B.S. in Botany from National Taiwan University, an M.S. in Biology from National Taiwan Normal University, and a Ph.D. in Science Education from North Carolina State University. Research centers on science education, educational games and web-based learning, and has produced two patents: a human immunity teaching device and an evolution learning game device."
				},
				photo: "/speaker-zheng-mengci.jpg"
			}
		]
	},
	{
		label: { zh: "論壇六", en: "Forum 6" },
		theme: { zh: "科創論壇", en: "Science Innovation Forum" },
		speakers: [
			{
				name: "施鈞瀚",
				title: { zh: "從數螞蟻到紅火蟻防治", en: "From Counting Ants to Red Imported Fire Ant Control" },
				bio: {
					zh: "「連續七天、每三分鐘數一次螞蟻」，這是施鈞瀚研究所時的題目——他想知道螞蟻在一天當中什麼時段出來覓食。當年很多人問他數這個要幹嘛。這個研究後來接上一款液態餌劑與專用餌站，取得兩項發明專利；他再從生物系轉到地理系念博士，讓電腦從空拍影像中自動找出紅火蟻的蟻丘。前一個問「什麼時候」，後一個問「在哪裡」，合起來就是防治下手的時機和地點。今天他創辦的公司替政府防治紅火蟻，累計作業面積超過七千公頃。這場演講，講一個從數螞蟻開始的故事。彰師大生物學系學士、碩士，地理學系博士。",
					en: "“Counting ants every three minutes for seven days straight” was the topic of his graduate research: he wanted to know at what time of day ants come out to forage. Back then, many people asked him what the point of counting was. The study was later connected to a liquid bait and a dedicated bait station, earning two invention patents; he then moved from biology to geography for his doctorate, teaching computers to automatically locate red imported fire ant mounds in aerial images. The first asks “when”, the second asks “where”; together they give the timing and the location for control work. The company he founded now carries out red imported fire ant control for the government, with a cumulative treated area of more than 7,000 hectares. This talk tells a story that began with counting ants. B.S. and M.S. in Biology, Ph.D. in Geography, National Changhua University of Education."
				},
				photo: "/speaker-shi-junhan.jpg"
			},
			{
				name: "徐偉婷",
				title: { zh: "科學，從一個想解決的問題開始", en: "Science Begins with a Problem You Want to Solve" },
				bio: {
					zh: "對我而言，走進科學研究並不是一條預先規劃好的路。從動物科學研究所畢業後，我選擇進入畜牧產業，也在第一線看見許多等待被解決的挑戰。這段經歷讓我萌生了一個想法：與其等待答案，能不能用自己的專業創造新的可能？於是，我帶著從產業累積的觀察重新回到學術領域，在中央研究院投入病毒與分子生物學研究，並於博士期間運用基因工程技術開發新型疫苗。然而，研究成果並不是終點，我更希望它能真正回應當初看見的需求。這份期待帶著我走向生技創業，推動技術從實驗室走向應用，並獲得「創業大聯盟競賽」總統獎肯定。一路走來，我相信科學的價值，不只是探索未知，更是從真實世界發現問題，再用科學尋找答案，最後把答案帶回需要它的地方。",
					en: "For me, entering scientific research was not a path planned in advance. After graduating from a graduate institute of animal science, I chose to enter the livestock industry, where I saw, on the front line, many challenges waiting to be solved. That experience gave me an idea: instead of waiting for answers, could I use my own expertise to create new possibilities? So I brought the observations I had gathered in industry back to academia, did research on viruses and molecular biology at Academia Sinica, and during my Ph.D. used genetic engineering to develop a new type of vaccine. But research results are not the end point; I wanted them to truly respond to the needs I had first seen. That aspiration led me into biotech entrepreneurship, moving technology from the laboratory toward application, and earning the Presidential Award at the Startup Alliance Competition (創業大聯盟競賽). Along the way, I have come to believe that the value of science lies not only in exploring the unknown, but in discovering problems in the real world, using science to find answers, and bringing those answers back to where they are needed."
				},
				photo: "/speaker-xu-weiting.jpg"
			}
		]
	},
	{
		label: { zh: "工作坊", en: "Workshops" },
		theme: { zh: "", en: "" },
		speakers: [
			{
				name: "顧廣毅",
				title: { zh: "老師・科學藝術工作坊", en: "Instructor · Science & Art Workshop" },
				bio: {
					zh: "現為國立陽明交通大學應用藝術研究所專任助理教授，同時於英國雪菲爾哈倫大學進行藝術設計與生物科學的跨領域創作博士研究。碩士畢業於荷蘭恩荷芬設計學院社會設計研究所、國立陽明交通大學牙醫學研究所、實踐大學媒體傳達設計研究所，大學畢業於高雄醫學大學牙醫學系；具有牙醫師、生物藝術家以及推測設計師等多重身分。他試圖拓展藝術、設計與科學結合的可能性，作品主要專注於臨床醫學、人類身體、人與其他物種的關係以及性別議題，嘗試藉由藝術實踐與設計方法去探索科學領域中的倫理問題，並藉此思考科技、人類個體和環境之間的關係。",
					en: "Currently a full-time Assistant Professor at the Institute of Applied Arts, National Yang Ming Chiao Tung University, and also pursuing practice-based doctoral research across art, design and the biological sciences at Sheffield Hallam University, UK. He holds master's degrees from the Social Design program at the Design Academy Eindhoven (Netherlands), the Institute of Dentistry at National Yang Ming Chiao Tung University, and the Graduate Institute of Media Design at Shih Chien University, and a bachelor's degree from the School of Dentistry at Kaohsiung Medical University. He is a dentist, a bio artist and a speculative designer. He seeks to extend the possibilities of combining art, design and science, with works focusing on clinical medicine, the human body, relationships between humans and other species, and gender issues, using artistic practice and design methods to explore ethical questions in science and to reflect on the relationships among technology, individuals and the environment."
				},
				photo: "/speaker-gu-guangyi.jpg"
			},
			{
				name: "關貫之",
				title: { zh: "老師・科學漫畫工作坊", en: "Instructor · Science Comics Workshop" },
				bio: { zh: "個人簡介待補充。", en: "Bio coming soon." },
				photo: null
			},
			{
				name: "鄂禹臻",
				title: { zh: "老師・科學漫畫工作坊", en: "Instructor · Science Comics Workshop" },
				bio: { zh: "個人簡介待補充。", en: "Bio coming soon." },
				photo: null
			},
			{
				name: "謝肇霖",
				title: { zh: "講師・標本工作坊", en: "Instructor · Specimen Workshop" },
				bio: {
					zh: "生命形式製作所創辦人、台灣標本協會理事，長期投入生態教育、自然史標本製作與生物模型開發，熟悉動物剝製、骨骼標本、翻模複製及樹脂封埋等技術。 曾主辦2025年第一屆台灣標本大賽。其製作的生物模型曾應用於八仙山《八方蛇集》新書發表、台灣標本大賽及其他自然史展示活動。目前以「生命形式製作所」推動生態教育、標本教學、自然史展示與教材開發。",
					en: "Hsieh is the founder of the Life Form Studio (生命形式製作所) and a director of the Taiwan Specimen Association (台灣標本協會), long engaged in ecological education, natural-history specimen making and biological model development, with expertise in taxidermy, skeletal specimens, mold-casting and resin embedding. Hsieh organized the first Taiwan Specimen Competition in 2025, and the models Hsieh has made have been used at the launch of the book 《八方蛇集》 at Mt. Baxian, at the competition and at other natural-history exhibitions. Through the studio, Hsieh now promotes ecological education, specimen teaching, natural-history displays and teaching-material development."
				},
				photo: null
			}
		]
	}
];

const groups = rawGroups.map((g) => ({
	label: g.label[lang],
	navLabel: g.nav ? g.nav[lang] : g.label[lang],
	theme: g.theme[lang],
	speakers: g.speakers.map((s) => ({
		name: lang === 'en' ? (s.nameEn || speakerEnName(s.name) || s.name) : s.name,
		link: s.link,
		title: s.title[lang],
		bio: s.bio[lang],
		photo: s.photo,
		pending: s.pending
	}))
}));

const flatSpeakers = groups.flatMap((g, gi) =>
	g.speakers.map((s) => ({ ...s, groupIndex: gi, groupLabel: g.label, groupTheme: g.theme }))
);
---

<Layout title={t.layoutTitle}>
	<a href={localizePath('/forum/2026', lang)} class="back-fab" aria-label={t.back}>←</a>

	<div class="speaker-pin-fixed" id="speaker-pin">
		{flatSpeakers.map((s, i) => (
			<div class={`speaker-slide ${i === 0 ? 'active' : ''}`} data-index={i} data-group={s.groupIndex}>
				<div class="speaker-bg" style={s.photo ? `background-image: url(${s.photo})` : ''}></div>

				<button class="mobile-group-toggle" data-toggle-index={i}>
					<span class="mobile-group-toggle-label">{s.groupLabel}</span>
					<span class="mobile-group-toggle-arrow">▾</span>
				</button>
				<div class="mobile-group-panel" data-panel-index={i}>
					{groups.map((g, gi) => (
						<button class={`mobile-group-item ${gi === s.groupIndex ? 'active' : ''}`} data-group-index={gi} type="button">
							{g.label}
							{g.theme && <span class="mobile-group-item-theme">{g.theme}</span>}
						</button>
					))}
				</div>

				<div class={`speaker-inner ${s.pending ? 'pending-layout' : ''}`}>
					<div class="speaker-text-col">
						<span class="speaker-section-label">
							{t.sectionLabel}・{s.groupLabel}{s.groupTheme ? `・${s.groupTheme}` : ''}
						</span>
						<h3>{s.link ? <a href={s.link} target="_blank" rel="noopener noreferrer" class="speaker-link">{s.name}</a> : s.name}</h3>
						<p class="speaker-title">{s.title}</p>
						<p class="speaker-bio">{s.bio}</p>
					</div>

					{!s.pending && groups[s.groupIndex].speakers.length > 1 && (
						<div class="member-dots-vertical">
							{groups[s.groupIndex].speakers.map((_, si) => {
								const globalIndex = groups.slice(0, s.groupIndex).reduce((sum, gg) => sum + gg.speakers.length, 0) + si;
								return (
									<button
										class={`member-dot ${globalIndex === i ? 'active' : ''}`}
										data-index={globalIndex}
										type="button"
										aria-label={t.nthSpeaker(si + 1)}
									></button>
								);
							})}
						</div>
					)}

					{!s.pending && (
						<div class="speaker-photo-col">
							{s.photo ? (
								<a href={s.link} target="_blank" rel="noopener noreferrer" class="speaker-photo-link"><img src={s.photo} alt={s.name} class="speaker-photo" /></a>
							) : (
								<div class="speaker-photo-placeholder">
									<span>{s.name.charAt(0)}</span>
								</div>
							)}
						</div>
					)}
				</div>
			</div>
		))}

		<div class="speaker-veil" id="speaker-veil"></div>

		<div class="group-list" id="group-list">
			{groups.map((g, gi) => (
				<button class={`group-list-item ${gi === 0 ? 'active' : ''}`} data-group-index={gi} type="button" data-full={g.theme ? `${g.label} · ${g.theme}` : g.label}>
					{g.navLabel}
				</button>
			))}
		</div>
	</div>

	<div class="mobile-swipe-hint" id="mobile-swipe-hint">
		<span>◂</span> {t.swipeHint} <span>▸</span>
	</div>

	<style>
		.back-fab {
			position: fixed;
			top: calc(var(--header-h, 74px) + 1.25rem);
			left: 2rem;
			width: 42px;
			height: 42px;
			border-radius: 50%;
			background: rgba(255,255,255,0.1);
			backdrop-filter: blur(8px);
			border: 1px solid rgba(255,255,255,0.2);
			color: #E8E9ED;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1.2rem;
			text-decoration: none;
			z-index: 20;
			transition: background 0.2s;
		}
		.back-fab:hover {
			background: rgba(255,255,255,0.2);
		}

		.mobile-group-toggle,
		.mobile-group-panel,
		.mobile-swipe-hint {
			display: none;
		}

		.speaker-pin-fixed {
			position: fixed;
			top: var(--header-h);
			left: 0;
			right: 0;
			height: calc(100vh - var(--header-h));
			background: #1B211D;
			overflow: hidden;
		}

		.group-list {
			position: absolute;
			right: 1.75rem;
			top: 50%;
			transform: translateY(-50%);
			display: flex;
			flex-direction: column;
			align-items: flex-end;
			gap: 0.15rem;
			z-index: 21;
		}
		.group-list-item {
			background: none;
			border: none;
			border-right: 2px solid transparent;
			color: #5C6070;
			font-size: 0.8rem;
			font-weight: 600;
			letter-spacing: 0.04em;
			padding: 0.45rem 0.9rem 0.45rem 0.6rem;
			cursor: pointer;
			text-align: right;
			transition: color 0.2s ease, border-color 0.2s ease;
			white-space: nowrap;
		}
		.group-list-item {
			position: relative;
		}
		.group-list-item::after {
			content: attr(data-full);
			position: absolute;
			right: calc(100% + 0.6rem);
			top: 50%;
			transform: translateY(-50%);
			background: rgba(20, 24, 26, 0.95);
			border: 1px solid rgba(212, 184, 118, 0.3);
			color: #E8E9ED;
			font-size: 0.75rem;
			font-weight: 600;
			letter-spacing: 0.02em;
			padding: 0.4rem 0.7rem;
			border-radius: 8px;
			white-space: nowrap;
			opacity: 0;
			pointer-events: none;
			transition: opacity 0.15s ease;
		}
		.group-list-item:hover::after {
			opacity: 1;
		}
		.group-list-item:hover {
			color: #B8BCC8;
		}
		.group-list-item.active {
			color: #D4B876;
			border-right-color: #D4B876;
			font-weight: 700;
		}

		.speaker-slide {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			opacity: 0;
			pointer-events: none;
			padding: 0 2rem;
			box-sizing: border-box;
		}
		.speaker-slide.active {
			opacity: 1;
			pointer-events: auto;
		}
		.speaker-veil {
			position: absolute;
			inset: 0;
			background: #1B211D;
			opacity: 0;
			pointer-events: none;
			z-index: 5;
			transition: opacity 0.15s ease;
		}
		.speaker-link {
			color: inherit;
			text-decoration: none;
			transition: color 0.2s ease;
		}
		.speaker-link:hover {
			color: #D4B876;
		}
		.speaker-photo-link {
			display: block;
		}
		.speaker-photo-link[href]:hover .speaker-photo {
			opacity: 0.92;
		}
		.speaker-veil.on {
			opacity: 1;
		}
		.speaker-bg {
			position: absolute;
			inset: 0;
			background-size: cover;
			background-position: center;
			filter: blur(35px) brightness(0.4);
			transform: scale(1.15);
		}
		.speaker-inner {
			position: relative;
			z-index: 1;
			max-width: 860px;
			width: 100%;
			max-height: calc(100vh - var(--header-h) - 4.5rem);
			display: flex;
			align-items: center;
			gap: 1.5rem;
		}
		.speaker-inner.pending-layout {
			justify-content: center;
			text-align: center;
		}
		.speaker-inner.pending-layout .speaker-text-col {
			flex: 0 1 auto;
			max-width: 600px;
			text-align: center;
		}
		.speaker-text-col {
			flex: 1 1 auto;
			max-height: calc(100vh - var(--header-h) - 5.5rem);
			overflow-y: auto;
			text-align: left;
			padding-right: 0.5rem;
		}
		.member-dots-vertical {
			flex: 0 0 auto;
			display: flex;
			flex-direction: column;
			gap: 0.55rem;
			align-items: center;
		}
		.member-dot {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: rgba(255,255,255,0.25);
			transition: background 0.3s, transform 0.2s;
			cursor: pointer;
			border: none;
			padding: 0;
			flex-shrink: 0;
		}
		.member-dot:hover {
			background: rgba(212, 184, 118, 0.5);
		}
		.member-dot.active {
			background: #D4B876;
			transform: scale(1.2);
		}
		.speaker-photo-col {
			flex: 0 0 38%;
		}
		.speaker-photo {
			width: 100%;
			aspect-ratio: 3 / 4;
			object-fit: cover;
			border-radius: 12px;
			display: block;
			box-shadow: 0 15px 40px rgba(0,0,0,0.4);
		}
		.speaker-photo-placeholder {
			width: 100%;
			aspect-ratio: 3 / 4;
			border-radius: 12px;
			background: rgba(212, 184, 118, 0.1);
			border: 1px solid rgba(212, 184, 118, 0.3);
			display: flex;
			align-items: center;
			justify-content: center;
			box-shadow: 0 15px 40px rgba(0,0,0,0.4);
		}
		.speaker-photo-placeholder span {
			font-size: 3.5rem;
			font-weight: 700;
			color: #D4B876;
			opacity: 0.6;
		}
		.speaker-section-label {
			display: block;
			font-size: 0.78rem;
			font-weight: 700;
			color: #E8D9C4;
			letter-spacing: 0.06em;
			margin-bottom: 0.85rem;
		}
		.speaker-slide h3 {
			font-size: 1.7rem;
			margin: 0 0 0.4rem;
			color: #FFFFFF;
		}
		.speaker-title {
			color: #D4B876;
			font-weight: 600;
			font-size: 0.9rem;
			margin: 0 0 1rem;
		}
		.speaker-bio {
			font-size: 0.82rem;
			color: #D8D8D8;
			line-height: 1.65;
			margin: 0;
			white-space: pre-line;
		}

		/* iPad／平板寬度：讓右側論壇清單自適應收窄，不再蓋住照片 */
		@media (min-width: 701px) and (max-width: 1080px) {
			.speaker-slide {
				padding-right: 6.5rem;
			}
			.group-list {
				right: 1rem;
				gap: 0.05rem;
			}
			.group-list-item {
				font-size: 0.72rem;
				padding: 0.35rem 0.6rem 0.35rem 0.35rem;
			}
			.speaker-inner {
				max-width: 100%;
			}
		}

		@media (max-width: 700px) {
			.back-fab {
				left: 1.25rem;
				width: 36px;
				height: 36px;
				font-size: 1.05rem;
				top: calc(var(--header-h, 74px) + 0.75rem);
			}

			.group-list {
				display: none;
			}

			/* 切換按鈕：放進每張 speaker-slide 內部，跟內容一起捲動 */
			.mobile-group-toggle {
				display: none;
				align-items: center;
				gap: 0.5rem;
				position: relative;
				width: fit-content;
				margin: 0 auto 1.75rem;
				background: none;
				border: none;
				border-bottom: 2px solid rgba(212, 184, 118, 0.5);
				padding: 0 0 0.35rem;
				color: #D4B876;
				font-size: 1.1rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				cursor: pointer;
				z-index: 3;
			}
			.speaker-slide.active .mobile-group-toggle {
				display: flex;
			}
			.mobile-group-toggle-arrow {
				color: #D4B876;
				font-size: 0.7rem;
				transition: transform 0.2s ease;
			}
			.mobile-group-toggle.open .mobile-group-toggle-arrow {
				transform: rotate(180deg);
			}

			.mobile-group-panel {
				display: none;
				flex-direction: column;
				position: absolute;
				top: 5.6rem;
				left: 50%;
				transform: translateX(-50%);
				width: min(80vw, 280px);
				max-height: 60vh;
				overflow-y: auto;
				background: rgba(20, 24, 26, 0.97);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 1px solid rgba(212, 184, 118, 0.25);
				border-radius: 14px;
				padding: 0.5rem;
				z-index: 22;
				box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
				gap: 0.15rem;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.2s ease, transform 0.2s ease;
			}
			.mobile-group-panel.open {
				display: flex;
				opacity: 1;
				pointer-events: auto;
				transform: translateX(-50%) translateY(0);
			}
			.mobile-group-item {
				background: none;
				border: none;
				border-radius: 10px;
				padding: 0.65rem 0.9rem;
				display: flex;
				align-items: baseline;
				gap: 0.5rem;
				color: #C8CBD4;
				font-size: 0.85rem;
				font-weight: 700;
				text-align: left;
				cursor: pointer;
			}
			.mobile-group-item-theme {
				font-size: 0.68rem;
				font-weight: 400;
				color: #7C8090;
			}
			.mobile-group-item.active {
				background: rgba(212, 184, 118, 0.15);
				color: #D4B876;
			}
			.mobile-group-item.active .mobile-group-item-theme {
				color: #D4B876;
				opacity: 0.75;
			}

			/* 底部提示 */
			.mobile-swipe-hint {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.4rem;
				position: fixed;
				bottom: 0;
				left: 0;
				right: 0;
				padding: 0.9rem 1rem calc(0.9rem + env(safe-area-inset-bottom, 0px));
				background: linear-gradient(180deg, rgba(27, 33, 29, 0) 0%, rgba(27, 33, 29, 0.85) 45%, #1B211D 100%);
				color: #A8ACBA;
				font-size: 0.72rem;
				letter-spacing: 0.02em;
				pointer-events: none;
				z-index: 21;
			}
			.mobile-swipe-hint span {
				color: #D4B876;
			}

			/* 手機版：改成正常文件流，允許整頁自由捲動 */
			.speaker-pin-fixed {
				position: static;
				top: auto;
				left: auto;
				right: auto;
				height: auto;
				overflow: visible;
			}
			.speaker-slide {
				position: relative;
				inset: auto;
				display: none;
				opacity: 1;
				pointer-events: auto;
				padding: calc(var(--header-h, 74px) + 1.5rem) 1.25rem 5rem;
				min-height: calc(100vh - var(--header-h));
				align-items: flex-start;
				flex-direction: column;
			}
			.speaker-slide.active {
				display: flex;
			}
			.speaker-veil {
				position: fixed;
				top: var(--header-h);
				height: calc(100vh - var(--header-h));
			}

			.speaker-inner {
				flex-direction: column-reverse;
				gap: 1rem;
				max-height: none;
				overflow-y: visible;
				max-width: 100%;
				width: 100%;
			}
			.speaker-photo-col {
				flex: 0 0 auto;
				width: 76%;
				margin: 0 auto;
			}
			.speaker-photo,
			.speaker-photo-placeholder {
				border-radius: 12px;
			}
			.speaker-photo-placeholder span {
				font-size: 3.4rem;
			}
			.speaker-text-col {
				max-height: none;
				overflow-y: visible;
				text-align: center;
				padding-right: 0;
			}
			.member-dots-vertical {
				flex-direction: row;
				justify-content: center;
			}
			.speaker-section-label {
				font-size: 0.72rem;
				margin-bottom: 0.7rem;
			}
			.speaker-slide h3 {
				font-size: 1.5rem;
				margin: 0 0 0.4rem;
			}
			.speaker-title {
				font-size: 0.9rem;
				margin: 0 0 0.75rem;
				line-height: 1.45;
			}
			.speaker-bio {
				font-size: 0.9rem;
				line-height: 1.7;
			}
		}
	</style>

	<script>
		const footer = document.querySelector('footer');
		if (footer) {
			footer.style.display = 'none';
		}

		const slides = Array.from(document.querySelectorAll('.speaker-slide'));
		const memberDots = Array.from(document.querySelectorAll('.member-dot'));
		const groupListItems = Array.from(document.querySelectorAll('.group-list-item'));
		const veil = document.getElementById('speaker-veil');
		const total = slides.length;

		let current = 0;
		let locked = false;

		let wheelAccumulated = 0;
		let settleTimer = null;
		const SETTLE_MS = 30;
		const VEIL_MS = 90;

		function isMobile() {
			return window.matchMedia('(max-width: 700px)').matches;
		}

		function applyBodyScrollLock() {
			document.body.style.overflow = isMobile() ? '' : 'hidden';
		}
		applyBodyScrollLock();
		window.addEventListener('resize', applyBodyScrollLock);

		function groupOf(index) {
			return parseInt(slides[index].dataset.group, 10);
		}

		function groupStart(g) {
			return slides.findIndex((s) => parseInt(s.dataset.group, 10) === g);
		}

		function closeAllMobilePanels() {
			document.querySelectorAll('.mobile-group-toggle.open').forEach((el) => el.classList.remove('open'));
			document.querySelectorAll('.mobile-group-panel.open').forEach((el) => el.classList.remove('open'));
		}

		function setActive(index) {
			current = Math.max(0, Math.min(total - 1, index));
			const activeGroup = groupOf(current);

			slides.forEach((s, i) => s.classList.toggle('active', i === current));
			memberDots.forEach((d) => {
				d.classList.toggle('active', parseInt(d.dataset.index, 10) === current);
			});
			groupListItems.forEach((item) => {
				item.classList.toggle('active', parseInt(item.dataset.groupIndex, 10) === activeGroup);
			});
			closeAllMobilePanels();

			if (isMobile()) {
				window.scrollTo({ top: 0, behavior: 'auto' });
			}
		}

		function jumpTo(target) {
			if (locked) return;
			if (target < 0 || target > total - 1) return;
			locked = true;
			veil.classList.add('on');
			setTimeout(() => {
				setActive(target);
				veil.classList.remove('on');
				setTimeout(() => {
					locked = false;
				}, VEIL_MS);
			}, VEIL_MS);
		}

		window.addEventListener('wheel', (e) => {
			if (isMobile()) return;
			e.preventDefault();
			if (locked) return;

			wheelAccumulated += e.deltaY;
			if (settleTimer) clearTimeout(settleTimer);
			settleTimer = setTimeout(() => {
				const acc = wheelAccumulated;
				wheelAccumulated = 0;
				if (acc > 5) jumpTo(current + 1);
				else if (acc < -5) jumpTo(current - 1);
			}, SETTLE_MS);
		}, { passive: false });

		let touchStartX = 0;
		let touchStartY = 0;
		let touchDirection = null;

		window.addEventListener('touchstart', (e) => {
			touchStartX = e.touches[0].clientX;
			touchStartY = e.touches[0].clientY;
			touchDirection = null;
		}, { passive: true });

		window.addEventListener('touchmove', (e) => {
			if (!isMobile()) {
				e.preventDefault();
				return;
			}

			const dx = e.touches[0].clientX - touchStartX;
			const dy = e.touches[0].clientY - touchStartY;

			if (touchDirection === null && (Math.abs(dx) > 10 || Math.abs(dy) > 10)) {
				touchDirection = Math.abs(dx) > Math.abs(dy) ? 'horizontal' : 'vertical';
			}

			if (touchDirection === 'horizontal') {
				e.preventDefault();
			}
		}, { passive: false });

		window.addEventListener('touchend', (e) => {
			if (locked) return;

			if (isMobile()) {
				if (touchDirection !== 'horizontal') return;
				const touchEndX = e.changedTouches[0].clientX;
				const diffX = touchStartX - touchEndX;
				if (diffX > 30) jumpTo(current + 1);
				else if (diffX < -30) jumpTo(current - 1);
			} else {
				const touchEndY = e.changedTouches[0].clientY;
				const diffY = touchStartY - touchEndY;
				if (diffY > 30) jumpTo(current + 1);
				else if (diffY < -30) jumpTo(current - 1);
			}
		});

		window.addEventListener('keydown', (e) => {
			if (locked) return;
			if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === 'ArrowRight') {
				e.preventDefault();
				jumpTo(current + 1);
			} else if (e.key === 'ArrowUp' || e.key === 'PageUp' || e.key === 'ArrowLeft') {
				e.preventDefault();
				jumpTo(current - 1);
			}
		});

		memberDots.forEach((dot) => {
			dot.addEventListener('click', () => {
				const target = parseInt(dot.dataset.index, 10);
				jumpTo(target);
			});
		});

		groupListItems.forEach((item) => {
			item.addEventListener('click', () => {
				const g = parseInt(item.dataset.groupIndex, 10);
				jumpTo(groupStart(g));
			});
		});

		document.querySelectorAll('.mobile-group-toggle').forEach((toggleBtn) => {
			toggleBtn.addEventListener('click', (e) => {
				e.stopPropagation();
				const idx = parseInt(toggleBtn.dataset.toggleIndex, 10);
				const panel = document.querySelector(`.mobile-group-panel[data-panel-index="${idx}"]`);
				const isOpen = panel.classList.contains('open');
				closeAllMobilePanels();
				if (!isOpen) {
					toggleBtn.classList.add('open');
					panel.classList.add('open');
				}
			});
		});

		document.querySelectorAll('.mobile-group-panel .mobile-group-item').forEach((item) => {
			item.addEventListener('click', () => {
				const g = parseInt(item.dataset.groupIndex, 10);
				closeAllMobilePanels();
				jumpTo(groupStart(g));
			});
		});

		document.addEventListener('click', (e) => {
			if (!e.target.closest('.mobile-group-toggle') && !e.target.closest('.mobile-group-panel')) {
				closeAllMobilePanels();
			}
		});

		const backLink = document.querySelector('.back-fab');
		if (backLink) {
			backLink.addEventListener('click', () => {
				document.body.style.overflow = '';
			});
		}
	</script>
</Layout>
