---
import Layout from '../../../layouts/Layout.astro';

const groups = [
	{
		label: "論壇一",
		theme: "青年科學家論壇",
		speakers: [
			{
				name: "謝至亮",
				title: "當閃光燈快到能看見電子？站在諾獎巨人們的肩上走科研之路",
				bio: "世界上最快的「閃光燈」，究竟能拍下什麼？從熟悉的相機閃光燈出發，我們將一路把光的時間尺度壓縮：從毫秒、微秒、奈秒、皮秒，到飛秒、甚至阿秒。這條路上，不僅誕生了改變現代科技的雷射與超快光學，也留下多項諾貝爾獎的精彩故事。而這也是我的科研旅程：從台灣交大碩士班的飛秒顯微術，到瑞士洛桑理工學院(EPFL)研究飛秒光與物質的非線性交互作用，以及讓光進行 AI 運算；如今，我在德國 attoworld 實驗室探索阿秒尺度的超快現象與應用。",
				photo: "/speaker-xie-zhiliang.jpg"
			},
			{
				name: "尉遲和妘",
				title: "黑洞能量提取與磁重聯",
				bio: "我於北京大學取得理論物理碩士學位。黑洞過往被認為是時空與信息的終點，然而隨著物理學家們的狂想與理論的發展，發現黑洞其實並非完全「只進不出」——自旋黑洞蘊藏的能量，有一部分是可以被合理提取出來的。磁重聯是磁化電漿中很常見的現象，從太陽閃焰到黑洞周圍的吸積流都看得到；而我的研究，正是探討這個現象在黑洞能量提取問題中，扮演什麼樣的角色。我目前最新的研究正將這套方法推廣到更一般的黑洞時空，檢驗當重力理論偏離廣義相對論時，對於黑洞的能量提取效率會如何改變。",
				photo: "/speaker-yuchih-hoyun.jpg"
			},
			{
				name: "王翊語",
				title: "跨領域的科學探索之路",
				bio: "國中小的科展是我對自然科學的啟蒙，後來幾個夏天在台灣野鳥協會做志工、高中接觸數學建模，這些培養了我探索不同領域的好奇心。大學時，我從資工的角度在中研院生物多樣性中心實習，後來以電腦模擬分析白蟻彈性大顎力學效能的大專學生計畫。除了資工系的分散式系統研究，我也因對後量子密碼學的興趣，再次進入中研院實習。一路輾轉不同學科後，我最後選擇在倫敦成為一名軟體工程師。雖然沒有走上學術研究，但這些科學探索帶給我的好奇、觀察與批判思考，至今仍深深影響我。",
				photo: "/speaker-wang-yiyu.jpg"
			}
		]
	},
	{
		label: "論壇二",
		theme: "大學科學參與論壇",
		speakers: [
			{
				name: "徐士展",
				title: "同樣的豉甲，不同的問題",
				bio: "從國小第一次接觸豉甲，到高中重新以物理的角度研究牠快速下潛的原因，我逐漸體會到，科學研究並不是一開始就要有多厲害的題目，而是從好奇、觀察與一個個問題慢慢累積而來。隨著學習力學、3D 建模與流體分析，我開始能將單純的現象轉化成假說，再透過模型與實驗驗證。這次分享希望從自己的成長經驗出發，談談哪些學習、環境與選擇能幫助青少年把好奇真正變成研究，以及在 AI 時代中，如何保有判斷與驗證答案的能力。",
				photo: "/speaker-xu-shizhan.jpg"
			},
			{
				name: "許禾臻",
				title: "高中：蚤蠅的高頻率間歇性運動之探討｜大學：未定",
				bio: "目前就讀國立臺灣大學牙醫學系三年級，高中就讀彰化高中科學班。受科學班課程規劃影響，我於高二開始接觸科學研究，因對物理與生物感興趣，進入中興大學生物力學實驗室，研究蚤蠅的高頻率間歇性運動。進入大學後，我因研究導論課接觸牙周幹細胞，並結合自身十字韌帶受傷的經驗，開始思考牙周幹細胞應用於韌帶修復的可能性，也由此踏上新的研究歷程。",
				photo: "/speaker-xu-hezhen.jpg"
			},
			{
				name: "張雨恩",
				title: "純爪抓附的意外多樣性：白蟻爪形態、抓附力與生態適應之力學分析",
				bio: "目前就讀陽明交通大學百川學程。高中時因為對物理與生物的興趣而投入生物力學研究，從白蟻在不同粗糙表面的抓附表現出發，延伸到物種、形態與行為等方面。進入百川不分系後，我仍持續投入科學研究，同時開始接觸程式軟體設計，在跨領域的環境中慢慢形塑自己的未來走向。對我而言，基礎科學不只是高中階段的研究，更是促使我持續探索興趣與增進能力、結合不同領域的起點。",
				photo: "/speaker-zhang-yuen.jpg"
			}
		]
	},
	{
		label: "論壇三",
		theme: "高中老師科學發展論壇",
		speakers: [
			{
				name: "講者確認中",
				title: "高中老師科學發展論壇・陣容公布中",
				bio: "本論壇講者名單尚在確認中，敬請期待正式公告。",
				photo: null,
				pending: true
			}
		]
	},
	{
		label: "論壇四",
		theme: "大學老師科學發展論壇",
		speakers: [
			{ name: "紀凱容", title: "大學老師科學發展論壇", bio: "個人簡介待補充。", photo: null },
			{ name: "李後鋒", title: "大學老師科學發展論壇", bio: "個人簡介待補充。", photo: null }
		]
	},
	{
		label: "科教論壇",
		theme: "",
		speakers: [
			{ name: "鄭夢慈", title: "教授・科教論壇", bio: "個人簡介待補充。", photo: null }
		]
	},
	{
		label: "科創論壇",
		theme: "",
		speakers: [
			{ name: "施鈞瀚", title: "博士・科創論壇", bio: "個人簡介待補充。", photo: null }
		]
	},
	{
		label: "工作坊",
		theme: "",
		speakers: [
			{ name: "顧廣毅", title: "老師・科學藝術工作坊", bio: "個人簡介待補充。", photo: null },
			{ name: "關貫之", title: "老師・科學漫畫工作坊", bio: "個人簡介待補充。", photo: null },
			{ name: "鄂禹臻", title: "老師・科學漫畫工作坊", bio: "個人簡介待補充。", photo: null }
		]
	}
];

const flatSpeakers = groups.flatMap((g, gi) =>
	g.speakers.map((s) => ({ ...s, groupIndex: gi, groupLabel: g.label, groupTheme: g.theme }))
);
---

<Layout title="講者陣容 | 第一屆臺灣青少年科學發展論壇">
	<a href="/forum/2026" class="back-fab" aria-label="返回論壇詳情">←</a>

	<div class="speaker-pin-fixed" id="speaker-pin">
		{flatSpeakers.map((s, i) => (
			<div class={`speaker-slide ${i === 0 ? 'active' : ''}`} data-index={i} data-group={s.groupIndex}>
				<div class="speaker-bg" style={s.photo ? `background-image: url(${s.photo})` : ''}></div>

				<button class="mobile-group-toggle" data-toggle-index={i}>
					<span class="mobile-group-toggle-label">{s.groupLabel}</span>
					<span class="mobile-group-toggle-arrow">▾</span>
				</button>
				<div class="mobile-group-panel" data-panel-index={i}>
					{groups.map((g, gi) => (
						<button class={`mobile-group-item ${gi === s.groupIndex ? 'active' : ''}`} data-group-index={gi} type="button">
							{g.label}
							{g.theme && <span class="mobile-group-item-theme">{g.theme}</span>}
						</button>
					))}
				</div>

				<div class={`speaker-inner ${s.pending ? 'pending-layout' : ''}`}>
					<div class="speaker-text-col">
						<span class="speaker-section-label">
							講者陣容・{s.groupLabel}{s.groupTheme ? `・${s.groupTheme}` : ''}
						</span>
						<h3>{s.name}</h3>
						<p class="speaker-title">{s.title}</p>
						<p class="speaker-bio">{s.bio}</p>
					</div>

					{!s.pending && groups[s.groupIndex].speakers.length > 1 && (
						<div class="member-dots-vertical">
							{groups[s.groupIndex].speakers.map((_, si) => {
								const globalIndex = groups.slice(0, s.groupIndex).reduce((sum, gg) => sum + gg.speakers.length, 0) + si;
								return (
									<button
										class={`member-dot ${globalIndex === i ? 'active' : ''}`}
										data-index={globalIndex}
										type="button"
										aria-label={`第 ${si + 1} 位講者`}
									></button>
								);
							})}
						</div>
					)}

					{!s.pending && (
						<div class="speaker-photo-col">
							{s.photo ? (
								<img src={s.photo} alt={s.name} class="speaker-photo" />
							) : (
								<div class="speaker-photo-placeholder">
									<span>{s.name.charAt(0)}</span>
								</div>
							)}
						</div>
					)}
				</div>
			</div>
		))}

		<div class="speaker-veil" id="speaker-veil"></div>

		<div class="group-list" id="group-list">
			{groups.map((g, gi) => (
				<button class={`group-list-item ${gi === 0 ? 'active' : ''}`} data-group-index={gi} type="button">
					{g.label}
				</button>
			))}
		</div>
	</div>

	<div class="mobile-swipe-hint" id="mobile-swipe-hint">
		<span>◂</span> 左右滑動切換講者・點擊上方切換論壇 <span>▸</span>
	</div>

	<style>
		.back-fab {
			position: fixed;
			top: calc(var(--header-h, 74px) + 1.25rem);
			left: 2rem;
			width: 42px;
			height: 42px;
			border-radius: 50%;
			background: rgba(255,255,255,0.1);
			backdrop-filter: blur(8px);
			border: 1px solid rgba(255,255,255,0.2);
			color: #E8E9ED;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1.2rem;
			text-decoration: none;
			z-index: 20;
			transition: background 0.2s;
		}
		.back-fab:hover {
			background: rgba(255,255,255,0.2);
		}

		.mobile-group-toggle,
		.mobile-group-panel,
		.mobile-swipe-hint {
			display: none;
		}

		.speaker-pin-fixed {
			position: fixed;
			top: var(--header-h);
			left: 0;
			right: 0;
			height: calc(100vh - var(--header-h));
			background: #1B211D;
			overflow: hidden;
		}

		.group-list {
			position: absolute;
			right: 1.75rem;
			top: 50%;
			transform: translateY(-50%);
			display: flex;
			flex-direction: column;
			align-items: flex-end;
			gap: 0.15rem;
			z-index: 21;
		}
		.group-list-item {
			background: none;
			border: none;
			border-right: 2px solid transparent;
			color: #5C6070;
			font-size: 0.8rem;
			font-weight: 600;
			letter-spacing: 0.04em;
			padding: 0.45rem 0.9rem 0.45rem 0.6rem;
			cursor: pointer;
			text-align: right;
			transition: color 0.2s ease, border-color 0.2s ease;
			white-space: nowrap;
		}
		.group-list-item:hover {
			color: #B8BCC8;
		}
		.group-list-item.active {
			color: #D4B876;
			border-right-color: #D4B876;
			font-weight: 700;
		}

		.speaker-slide {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			opacity: 0;
			pointer-events: none;
			padding: 0 2rem;
			box-sizing: border-box;
		}
		.speaker-slide.active {
			opacity: 1;
			pointer-events: auto;
		}
		.speaker-veil {
			position: absolute;
			inset: 0;
			background: #1B211D;
			opacity: 0;
			pointer-events: none;
			z-index: 5;
			transition: opacity 0.15s ease;
		}
		.speaker-veil.on {
			opacity: 1;
		}
		.speaker-bg {
			position: absolute;
			inset: 0;
			background-size: cover;
			background-position: center;
			filter: blur(35px) brightness(0.4);
			transform: scale(1.15);
		}
		.speaker-inner {
			position: relative;
			z-index: 1;
			max-width: 860px;
			width: 100%;
			max-height: calc(100vh - var(--header-h) - 4.5rem);
			display: flex;
			align-items: center;
			gap: 1.5rem;
		}
		.speaker-inner.pending-layout {
			justify-content: center;
			text-align: center;
		}
		.speaker-inner.pending-layout .speaker-text-col {
			flex: 0 1 auto;
			max-width: 600px;
			text-align: center;
		}
		.speaker-text-col {
			flex: 1 1 auto;
			max-height: calc(100vh - var(--header-h) - 5.5rem);
			overflow-y: auto;
			text-align: left;
			padding-right: 0.5rem;
		}
		.member-dots-vertical {
			flex: 0 0 auto;
			display: flex;
			flex-direction: column;
			gap: 0.55rem;
			align-items: center;
		}
		.member-dot {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: rgba(255,255,255,0.25);
			transition: background 0.3s, transform 0.2s;
			cursor: pointer;
			border: none;
			padding: 0;
			flex-shrink: 0;
		}
		.member-dot:hover {
			background: rgba(212, 184, 118, 0.5);
		}
		.member-dot.active {
			background: #D4B876;
			transform: scale(1.2);
		}
		.speaker-photo-col {
			flex: 0 0 38%;
		}
		.speaker-photo {
			width: 100%;
			aspect-ratio: 3 / 4;
			object-fit: cover;
			border-radius: 12px;
			display: block;
			box-shadow: 0 15px 40px rgba(0,0,0,0.4);
		}
		.speaker-photo-placeholder {
			width: 100%;
			aspect-ratio: 3 / 4;
			border-radius: 12px;
			background: rgba(212, 184, 118, 0.1);
			border: 1px solid rgba(212, 184, 118, 0.3);
			display: flex;
			align-items: center;
			justify-content: center;
			box-shadow: 0 15px 40px rgba(0,0,0,0.4);
		}
		.speaker-photo-placeholder span {
			font-size: 3.5rem;
			font-weight: 700;
			color: #D4B876;
			opacity: 0.6;
		}
		.speaker-section-label {
			display: block;
			font-size: 0.78rem;
			font-weight: 700;
			color: #E8D9C4;
			letter-spacing: 0.06em;
			margin-bottom: 0.85rem;
		}
		.speaker-slide h3 {
			font-size: 1.7rem;
			margin: 0 0 0.4rem;
			color: #FFFFFF;
		}
		.speaker-title {
			color: #D4B876;
			font-weight: 600;
			font-size: 0.9rem;
			margin: 0 0 1rem;
		}
		.speaker-bio {
			font-size: 0.82rem;
			color: #D8D8D8;
			line-height: 1.65;
			margin: 0;
		}

		/* iPad／平板寬度：讓右側論壇清單自適應收窄，不再蓋住照片 */
		@media (min-width: 701px) and (max-width: 1080px) {
			.speaker-slide {
				padding-right: 6.5rem;
			}
			.group-list {
				right: 1rem;
				gap: 0.05rem;
			}
			.group-list-item {
				font-size: 0.72rem;
				padding: 0.35rem 0.6rem 0.35rem 0.35rem;
			}
			.speaker-inner {
				max-width: 100%;
			}
		}

		@media (max-width: 700px) {
			.back-fab {
				left: 1.25rem;
				width: 36px;
				height: 36px;
				font-size: 1.05rem;
				top: calc(var(--header-h, 74px) + 0.75rem);
			}

			.group-list {
				display: none;
			}

			/* 切換按鈕：放進每張 speaker-slide 內部，跟內容一起捲動 */
			.mobile-group-toggle {
				display: none;
				align-items: center;
				gap: 0.5rem;
				position: relative;
				width: fit-content;
				margin: 0 auto 1.75rem;
				background: none;
				border: none;
				border-bottom: 2px solid rgba(212, 184, 118, 0.5);
				padding: 0 0 0.35rem;
				color: #D4B876;
				font-size: 1.1rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				cursor: pointer;
				z-index: 3;
			}
			.speaker-slide.active .mobile-group-toggle {
				display: flex;
			}
			.mobile-group-toggle-arrow {
				color: #D4B876;
				font-size: 0.7rem;
				transition: transform 0.2s ease;
			}
			.mobile-group-toggle.open .mobile-group-toggle-arrow {
				transform: rotate(180deg);
			}

			.mobile-group-panel {
				display: none;
				flex-direction: column;
				position: absolute;
				top: 5.6rem;
				left: 50%;
				transform: translateX(-50%);
				width: min(80vw, 280px);
				max-height: 60vh;
				overflow-y: auto;
				background: rgba(20, 24, 26, 0.97);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 1px solid rgba(212, 184, 118, 0.25);
				border-radius: 14px;
				padding: 0.5rem;
				z-index: 22;
				box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
				gap: 0.15rem;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.2s ease, transform 0.2s ease;
			}
			.mobile-group-panel.open {
				display: flex;
				opacity: 1;
				pointer-events: auto;
				transform: translateX(-50%) translateY(0);
			}
			.mobile-group-item {
				background: none;
				border: none;
				border-radius: 10px;
				padding: 0.65rem 0.9rem;
				display: flex;
				align-items: baseline;
				gap: 0.5rem;
				color: #C8CBD4;
				font-size: 0.85rem;
				font-weight: 700;
				text-align: left;
				cursor: pointer;
			}
			.mobile-group-item-theme {
				font-size: 0.68rem;
				font-weight: 400;
				color: #7C8090;
			}
			.mobile-group-item.active {
				background: rgba(212, 184, 118, 0.15);
				color: #D4B876;
			}
			.mobile-group-item.active .mobile-group-item-theme {
				color: #D4B876;
				opacity: 0.75;
			}

			/* 底部提示 */
			.mobile-swipe-hint {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.4rem;
				position: fixed;
				bottom: 0;
				left: 0;
				right: 0;
				padding: 0.9rem 1rem calc(0.9rem + env(safe-area-inset-bottom, 0px));
				background: linear-gradient(180deg, rgba(27, 33, 29, 0) 0%, rgba(27, 33, 29, 0.85) 45%, #1B211D 100%);
				color: #A8ACBA;
				font-size: 0.72rem;
				letter-spacing: 0.02em;
				pointer-events: none;
				z-index: 21;
			}
			.mobile-swipe-hint span {
				color: #D4B876;
			}

			/* 手機版：改成正常文件流，允許整頁自由捲動 */
			.speaker-pin-fixed {
				position: static;
				top: auto;
				left: auto;
				right: auto;
				height: auto;
				overflow: visible;
			}
			.speaker-slide {
				position: relative;
				inset: auto;
				display: none;
				opacity: 1;
				pointer-events: auto;
				padding: calc(var(--header-h, 74px) + 1.5rem) 1.25rem 5rem;
				min-height: calc(100vh - var(--header-h));
				align-items: flex-start;
				flex-direction: column;
			}
			.speaker-slide.active {
				display: flex;
			}
			.speaker-veil {
				position: fixed;
				top: var(--header-h);
				height: calc(100vh - var(--header-h));
			}

			.speaker-inner {
				flex-direction: column-reverse;
				gap: 1rem;
				max-height: none;
				overflow-y: visible;
				max-width: 100%;
				width: 100%;
			}
			.speaker-photo-col {
				flex: 0 0 auto;
				width: 76%;
				margin: 0 auto;
			}
			.speaker-photo,
			.speaker-photo-placeholder {
				border-radius: 12px;
			}
			.speaker-photo-placeholder span {
				font-size: 3.4rem;
			}
			.speaker-text-col {
				max-height: none;
				overflow-y: visible;
				text-align: center;
				padding-right: 0;
			}
			.member-dots-vertical {
				flex-direction: row;
				justify-content: center;
			}
			.speaker-section-label {
				font-size: 0.72rem;
				margin-bottom: 0.7rem;
			}
			.speaker-slide h3 {
				font-size: 1.5rem;
				margin: 0 0 0.4rem;
			}
			.speaker-title {
				font-size: 0.9rem;
				margin: 0 0 0.75rem;
				line-height: 1.45;
			}
			.speaker-bio {
				font-size: 0.9rem;
				line-height: 1.7;
			}
		}
	</style>

	<script>
		const footer = document.querySelector('footer');
		if (footer) {
			footer.style.display = 'none';
		}

		const slides = Array.from(document.querySelectorAll('.speaker-slide'));
		const memberDots = Array.from(document.querySelectorAll('.member-dot'));
		const groupListItems = Array.from(document.querySelectorAll('.group-list-item'));
		const veil = document.getElementById('speaker-veil');
		const total = slides.length;

		let current = 0;
		let locked = false;

		let wheelAccumulated = 0;
		let settleTimer = null;
		const SETTLE_MS = 30;
		const VEIL_MS = 90;

		function isMobile() {
			return window.matchMedia('(max-width: 700px)').matches;
		}

		function applyBodyScrollLock() {
			document.body.style.overflow = isMobile() ? '' : 'hidden';
		}
		applyBodyScrollLock();
		window.addEventListener('resize', applyBodyScrollLock);

		function groupOf(index) {
			return parseInt(slides[index].dataset.group, 10);
		}

		function groupStart(g) {
			return slides.findIndex((s) => parseInt(s.dataset.group, 10) === g);
		}

		function groupEnd(g) {
			for (let i = slides.length - 1; i >= 0; i--) {
				if (parseInt(slides[i].dataset.group, 10) === g) return i;
			}
			return 0;
		}

		function closeAllMobilePanels() {
			document.querySelectorAll('.mobile-group-toggle.open').forEach((el) => el.classList.remove('open'));
			document.querySelectorAll('.mobile-group-panel.open').forEach((el) => el.classList.remove('open'));
		}

		function setActive(index) {
			current = Math.max(0, Math.min(total - 1, index));
			const activeGroup = groupOf(current);

			slides.forEach((s, i) => s.classList.toggle('active', i === current));
			memberDots.forEach((d) => {
				d.classList.toggle('active', parseInt(d.dataset.index, 10) === current);
			});
			groupListItems.forEach((item) => {
				item.classList.toggle('active', parseInt(item.dataset.groupIndex, 10) === activeGroup);
			});
			closeAllMobilePanels();

			if (isMobile()) {
				window.scrollTo({ top: 0, behavior: 'auto' });
			}
		}

		function jumpTo(target) {
			if (locked) return;
			if (target < 0 || target > total - 1) return;
			locked = true;
			veil.classList.add('on');
			setTimeout(() => {
				setActive(target);
				veil.classList.remove('on');
				setTimeout(() => {
					locked = false;
				}, VEIL_MS);
			}, VEIL_MS);
		}

		function doSwitchWithinGroup(target) {
			const activeGroup = groupOf(current);
			const clamped = Math.max(groupStart(activeGroup), Math.min(groupEnd(activeGroup), target));
			if (clamped === current) return;
			jumpTo(clamped);
		}

		window.addEventListener('wheel', (e) => {
			if (isMobile()) return;
			e.preventDefault();
			if (locked) return;

			wheelAccumulated += e.deltaY;
			if (settleTimer) clearTimeout(settleTimer);
			settleTimer = setTimeout(() => {
				const acc = wheelAccumulated;
				wheelAccumulated = 0;
				if (acc > 5) doSwitchWithinGroup(current + 1);
				else if (acc < -5) doSwitchWithinGroup(current - 1);
			}, SETTLE_MS);
		}, { passive: false });

		let touchStartX = 0;
		let touchStartY = 0;
		let touchDirection = null;

		window.addEventListener('touchstart', (e) => {
			touchStartX = e.touches[0].clientX;
			touchStartY = e.touches[0].clientY;
			touchDirection = null;
		}, { passive: true });

		window.addEventListener('touchmove', (e) => {
			if (!isMobile()) {
				e.preventDefault();
				return;
			}

			const dx = e.touches[0].clientX - touchStartX;
			const dy = e.touches[0].clientY - touchStartY;

			if (touchDirection === null && (Math.abs(dx) > 10 || Math.abs(dy) > 10)) {
				touchDirection = Math.abs(dx) > Math.abs(dy) ? 'horizontal' : 'vertical';
			}

			if (touchDirection === 'horizontal') {
				e.preventDefault();
			}
		}, { passive: false });

		window.addEventListener('touchend', (e) => {
			if (locked) return;

			if (isMobile()) {
				if (touchDirection !== 'horizontal') return;
				const touchEndX = e.changedTouches[0].clientX;
				const diffX = touchStartX - touchEndX;
				if (diffX > 30) doSwitchWithinGroup(current + 1);
				else if (diffX < -30) doSwitchWithinGroup(current - 1);
			} else {
				const touchEndY = e.changedTouches[0].clientY;
				const diffY = touchStartY - touchEndY;
				if (diffY > 30) doSwitchWithinGroup(current + 1);
				else if (diffY < -30) doSwitchWithinGroup(current - 1);
			}
		});

		window.addEventListener('keydown', (e) => {
			if (locked) return;
			if (e.key === 'ArrowDown' || e.key === 'PageDown' || e.key === 'ArrowRight') {
				e.preventDefault();
				doSwitchWithinGroup(current + 1);
			} else if (e.key === 'ArrowUp' || e.key === 'PageUp' || e.key === 'ArrowLeft') {
				e.preventDefault();
				doSwitchWithinGroup(current - 1);
			}
		});

		memberDots.forEach((dot) => {
			dot.addEventListener('click', () => {
				const target = parseInt(dot.dataset.index, 10);
				jumpTo(target);
			});
		});

		groupListItems.forEach((item) => {
			item.addEventListener('click', () => {
				const g = parseInt(item.dataset.groupIndex, 10);
				jumpTo(groupStart(g));
			});
		});

		document.querySelectorAll('.mobile-group-toggle').forEach((toggleBtn) => {
			toggleBtn.addEventListener('click', (e) => {
				e.stopPropagation();
				const idx = parseInt(toggleBtn.dataset.toggleIndex, 10);
				const panel = document.querySelector(`.mobile-group-panel[data-panel-index="${idx}"]`);
				const isOpen = panel.classList.contains('open');
				closeAllMobilePanels();
				if (!isOpen) {
					toggleBtn.classList.add('open');
					panel.classList.add('open');
				}
			});
		});

		document.querySelectorAll('.mobile-group-panel .mobile-group-item').forEach((item) => {
			item.addEventListener('click', () => {
				const g = parseInt(item.dataset.groupIndex, 10);
				closeAllMobilePanels();
				jumpTo(groupStart(g));
			});
		});

		document.addEventListener('click', (e) => {
			if (!e.target.closest('.mobile-group-toggle') && !e.target.closest('.mobile-group-panel')) {
				closeAllMobilePanels();
			}
		});

		const backLink = document.querySelector('.back-fab');
		if (backLink) {
			backLink.addEventListener('click', () => {
				document.body.style.overflow = '';
			});
		}
	</script>
</Layout>
