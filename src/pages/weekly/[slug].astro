---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const modules = import.meta.glob('../../data/weekly/*.md', { eager: true }) as Record<string, any>;
	const issues = Object.entries(modules)
		.map(([path, mod]) => ({
			slug: path.split('/').pop()!.replace(/\.md$/, ''),
			mod
		}))
		.sort((a, b) =>
			a.mod.frontmatter.date < b.mod.frontmatter.date ? 1 : a.mod.frontmatter.date > b.mod.frontmatter.date ? -1 : 0
		);

	return issues.map((it, idx) => {
		const older = issues[idx + 1];
		const newer = issues[idx - 1];
		return {
			params: { slug: it.slug },
			props: {
				mod: it.mod,
				older: older && older.mod.frontmatter.series === it.mod.frontmatter.series
					? { slug: older.slug, title: older.mod.frontmatter.title, issue: older.mod.frontmatter.issue }
					: null,
				newer: newer && newer.mod.frontmatter.series === it.mod.frontmatter.series
					? { slug: newer.slug, title: newer.mod.frontmatter.title, issue: newer.mod.frontmatter.issue }
					: null
			}
		};
	});
}

const { mod, older, newer } = Astro.props;
const fm = mod.frontmatter;
const Content = mod.Content;
---

<Layout title={`${fm.seriesName} 第 ${String(fm.issue).padStart(3, '0')} 期`}>
	<div class="panel">
		<article class="panel-inner">
			<a class="back" href="/weekly/">← 週報列表</a>

			<div class="meta">
				<span class="series">{fm.seriesName}</span>
				<span>第 {String(fm.issue).padStart(3, '0')} 期</span>
				<span>{fm.year} 年第 {fm.week} 週</span>
				<span>{fm.period ?? `編輯日期 ${fm.date}`}</span>
			</div>
			<h1 class="title">{fm.title}</h1>

			<div class="weekly-body">
				<Content />
			</div>

			<nav class="pager" aria-label="上一期與下一期">
				{older ? (
					<a href={`/weekly/${older.slug}/`}>
						<span class="pager-label">← 上一期（第 {String(older.issue).padStart(3, '0')} 期）</span>
						<span class="pager-title">{older.title}</span>
					</a>
				) : <span></span>}
				{newer ? (
					<a class="pager-next" href={`/weekly/${newer.slug}/`}>
						<span class="pager-label">下一期（第 {String(newer.issue).padStart(3, '0')} 期） →</span>
						<span class="pager-title">{newer.title}</span>
					</a>
				) : <span></span>}
			</nav>
		</article>
	</div>

	<style>
		.panel {
			position: relative;
			background: var(--panel-bg);
			color: var(--card-text);
			}
		.panel-inner {
			position: relative;
			max-width: 760px;
			margin: 0 auto;
			padding: 2.5rem 2rem 4rem;
			box-sizing: border-box;
		}
		.back {
			display: inline-block;
			font-size: 0.9rem;
			color: #3d7a5b;
			text-decoration: none;
			margin-bottom: 1.5rem;
		}
		.back:hover {
			text-decoration: underline;
		}
		.meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.4rem 1rem;
			font-size: 0.85rem;
			color: var(--card-text-muted);
			margin-bottom: 0.75rem;
		}
		.meta .series {
			color: #a6863c;
			font-weight: 700;
		}
		.title {
			font-size: 1.6rem;
			line-height: 1.5;
			color: var(--card-text);
			margin: 0 0 2rem;
		}
		.weekly-body :global(h2) {
			font-size: 1.25rem;
			color: #a6863c;
			margin: 3rem 0 1rem;
			padding-bottom: 0.5rem;
			border-bottom: 1px solid rgba(166, 134, 60, 0.5);
		}
		.weekly-body :global(h3) {
			font-size: 1.05rem;
			line-height: 1.6;
			color: #3d7a5b;
			margin: 2rem 0 0.5rem;
		}
		.weekly-body :global(p) {
			line-height: 1.9;
			margin: 0 0 1rem;
			color: var(--card-text);
			overflow-wrap: anywhere;
		}
		.weekly-body :global(strong) {
			color: #000;
		}
		.weekly-body :global(em) {
			font-style: normal;
			font-size: 0.9rem;
			color: var(--card-text-muted);
		}
		.weekly-body :global(ul) {
			padding-left: 1.2rem;
			margin: 0 0 1rem;
		}
		.weekly-body :global(li) {
			line-height: 1.8;
			margin-bottom: 0.8rem;
			color: var(--card-text);
		}
		.weekly-body :global(a) {
			color: #3d7a5b;
			overflow-wrap: anywhere;
		}
		.weekly-body :global(img) {
			display: block;
			max-width: 100%;
			height: auto;
			margin: 0.5rem auto 0.3rem;
			border-radius: 8px;
			background: #fff;
			border: 1px solid rgba(42, 38, 32, 0.12);
		}
		.weekly-body :global(hr) {
			border: 0;
			border-top: 1px solid rgba(42, 38, 32, 0.18);
			margin: 2.5rem 0 1.5rem;
		}
		.pager {
			display: flex;
			justify-content: space-between;
			gap: 1rem;
			margin-top: 3.5rem;
			padding-top: 1.5rem;
			border-top: 1px solid rgba(42, 38, 32, 0.18);
		}
		.pager a {
			flex: 1 1 0;
			min-width: 0;
			display: flex;
			flex-direction: column;
			gap: 0.3rem;
			color: inherit;
			text-decoration: none;
		}
		.pager-next {
			text-align: right;
		}
		.pager-label {
			font-size: 0.82rem;
			color: #3d7a5b;
		}
		.pager-title {
			font-size: 0.92rem;
			line-height: 1.5;
			color: var(--card-text);
		}
		@media (max-width: 600px) {
			.panel-inner {
				padding: 2rem 1.25rem 3rem;
			}
			.title {
				font-size: 1.35rem;
			}
			.pager {
				flex-direction: column;
			}
			.pager-next {
				text-align: left;
			}
		}
	</style>
</Layout>
