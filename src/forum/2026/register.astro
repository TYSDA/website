---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="立即報名 | 第一屆臺灣青少年科學發展論壇">
	<div class="panel">
		<div class="panel-inner">
			<a href="/forum/2026">← 返回論壇詳情</a>

			<h2>立即報名</h2>
			<p>請填寫以下表單完成報名，我們將於審核後透過 Email 通知報名結果。</p>

			<a href="#" class="register-button">前往報名表單</a>
		</div>
	</div>

	<style>
		.panel {
			background: var(--panel-bg);
			color: var(--card-text);
			padding-top: var(--header-h, 90px);
		}
		.panel h1, .panel h2, .panel h3 {
			color: var(--card-text);
		}
		.panel-inner {
			max-width: 800px;
			margin: 0 auto;
			padding: 2.5rem 2rem;
		}
		.register-button {
			display: inline-block;
			background: var(--orange);
			color: #FFFFFF;
			padding: 0.9rem 2.5rem;
			border-radius: 8px;
			font-weight: 600;
			text-decoration: none;
			margin-top: 1rem;
		}
		.register-button:hover {
			opacity: 0.9;
		}
	</style>
</Layout>