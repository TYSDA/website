---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, localizePath } from '../../i18n/ui';

export function getStaticPaths() {
	return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}

const lang = getLangFromUrl(Astro.url);

const content = {
	zh: {
		pageTitle: '首頁',
		slides: [
			{
				label: "最新活動",
				title: "第一屆臺灣青少年科學發展論壇",
				date: "2026年12月25日－12月26日・國立臺灣科學教育館",
				link: "/forum/2026"
			},
			{
				label: "工作坊",
				title: "台中國際動漫博覽會 同人文創市集",
				date: "2026年9月19日（六）－9月20日（日） 11:00-18:00・台中市政府 文心樓 1樓",
				link: "/activities"
			}
		],
		heroCta: "查看詳情 →",
		prev: "上一張",
		next: "下一張",
		dotLabel: (n: number) => `第 ${n} 張`,
		intro:
			"我們相信每一位對科學充滿好奇的青少年，都值得公平獲取學術與研究資源的機會。\n在這裡，你可以認識我們的團隊、瀏覽最新活動，一起探索科學的世界。",
		activitiesTitle: "協會活動",
		activitiesAll: "查看所有活動 →",
		categories: [
			{ name: "論壇", link: "/activities#forum", bg: "/forum.png" },
			{ name: "課程", link: "/activities#course", bg: "/lecture.png" },
			{ name: "工作坊", link: "/activities#workshop", bg: "/workshop.png" },
			{ name: "會員活動", link: "/activities#assembly", bg: "/assembly.png" }
		],
		membersTitle: "協會成員",
		membersAll: "查看全部成員 →"
	},
	en: {
		pageTitle: 'Home',
		slides: [
			{
				label: "Latest Event",
				title: "The 1st Taiwan Young Science Development Forum",
				date: "December 25–26, 2026 · National Taiwan Science Education Center",
				link: "/forum/2026"
			},
			{
				label: "Workshop",
				title: "Taichung International Animation & Comics Expo – Doujin & Creative Market",
				date: "Sat–Sun, September 19–20, 2026, 11:00–18:00 · 1F, Wenxin Building, Taichung City Government",
				link: "/activities"
			}
		],
		heroCta: "Learn more →",
		prev: "Previous slide",
		next: "Next slide",
		dotLabel: (n: number) => `Slide ${n}`,
		intro:
			"We believe every young person who is curious about science deserves fair access to academic and research resources.\nHere you can meet our team, browse our latest activities, and explore the world of science together.",
		activitiesTitle: "Activities",
		activitiesAll: "View all activities →",
		categories: [
			{ name: "Forums", link: "/activities#forum", bg: "/forum.png" },
			{ name: "Courses", link: "/activities#course", bg: "/lecture.png" },
			{ name: "Workshops", link: "/activities#workshop", bg: "/workshop.png" },
			{ name: "Member Events", link: "/activities#assembly", bg: "/assembly.png" }
		],
		membersTitle: "Members",
		membersAll: "View all members →"
	}
};

const c = content[lang];

// en 欄位填英文姓名；留空字串時英文版會先顯示中文姓名
const members = [
	{ zh: "關貫之", en: "Kuan-Chih Kuan" },
	{ zh: "謝至亮", en: "Chih-Liang Hsieh" },
	{ zh: "尉遲和妘", en: "Ho-Yun YuChih", link: "https://hoyunyuchih.github.io/#intro" },
	{ zh: "顧廣毅", en: "Kuang-Yi Ku", link: "https://www.kukuangyi.com/" },
	{ zh: "邱俊禕", en: "Chun-Wei Chiu" }
];
---

<Layout title={c.pageTitle}>
	<div class="hero-carousel">
		<div class="hero-track" id="hero-track">
			{c.slides.map((s) => (
				<a href={localizePath(s.link, lang)} class="hero-slide">
					<p class="hero-label">{s.label}</p>
					<h2>{s.title}</h2>
					<p class="hero-date">{s.date}</p>
					<span class="hero-cta">{c.heroCta}</span>
				</a>
			))}
		</div>
		<button class="hero-arrow hero-prev" id="hero-prev" aria-label={c.prev}>‹</button>
		<button class="hero-arrow hero-next" id="hero-next" aria-label={c.next}>›</button>
		<div class="hero-dots" id="hero-dots">
			{c.slides.map((_, i) => (
				<button class="hero-dot" data-index={i} aria-label={c.dotLabel(i + 1)}></button>
			))}
		</div>
	</div>

	<div class="panel">
		<div class="panel-inner">
			<p>{c.intro}</p>
		</div>
	</div>

	<div class="panel">
		<div class="panel-inner">
			<h2>{c.activitiesTitle}</h2>
			<div class="category-preview-grid">
				{c.categories.map((cat) => (
					<a href={localizePath(cat.link, lang)} class="category-preview-card" style={`background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url(${cat.bg})`}>
						{cat.name}
					</a>
				))}
			</div>
			<a href={localizePath('/activities', lang)}>{c.activitiesAll}</a>
		</div>
	</div>

	<div class="panel">
		<div class="panel-inner">
			<h2>{c.membersTitle}</h2>
			<div class="member-preview-grid">
				{members.map((m) => (
					<div class="member-preview-card">
						<p class="member-name">{m.link ? <a href={m.link} target="_blank" rel="noopener noreferrer">{lang === 'en' && m.en ? m.en : m.zh}</a> : (lang === 'en' && m.en ? m.en : m.zh)}</p>
					</div>
				))}
			</div>
			<a href={localizePath('/members', lang)}>{c.membersAll}</a>
		</div>
	</div>

	<style>
		.panel {
			background: var(--panel-bg);
			color: var(--card-text);
			margin-bottom: 1.5rem;
		}
		.panel h1, .panel h2, .panel h3 {
			color: var(--card-text);
		}
		.panel-inner {
			max-width: 800px;
			margin: 0 auto;
			padding: 2.5rem 2rem;
		}
		.hero-carousel {
			position: relative;
			width: 100%;
			overflow: hidden;
		}
		.hero-track {
			display: flex;
			transition: transform 0.4s ease;
		}
		.hero-slide {
			flex: 0 0 100%;
			display: flex;
			flex-direction: column;
			justify-content: center;
			background: linear-gradient(135deg, #242B26, #2E362F);
			padding: 10rem 10vw 5rem;
			min-height: 100svh;
			text-decoration: none;
			color: var(--text);
			box-sizing: border-box;
		}
		.hero-slide:nth-child(1) {
			background:
				linear-gradient(rgba(27, 33, 29, 0.65), rgba(27, 33, 29, 0.65)),
				url('/forum-bg.png');
			background-size: cover;
			background-position: center;
		}
		.hero-slide:nth-child(2) {
			background:
				linear-gradient(rgba(27, 33, 29, 0.55), rgba(27, 33, 29, 0.55)),
				url('/workshop.png');
			background-size: cover;
			background-position: center;
		}
		.hero-label {
			color: var(--yellow);
			font-size: 0.9rem;
			font-weight: 600;
			margin: 0 0 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}
		.hero-slide h2 {
			margin: 0 0 0.75rem;
			font-size: 2.25rem;
			color: var(--text);
		}
		.hero-date {
			color: var(--text-muted);
			margin: 0 0 1.5rem;
			font-size: 1.1rem;
		}
		.hero-cta {
			color: var(--yellow);
			font-weight: 600;
			font-size: 1rem;
		}
		.hero-arrow {
			position: absolute;
			top: 55%;
			transform: translateY(-50%);
			background: rgba(0, 0, 0, 0.4);
			color: var(--text);
			border: none;
			border-radius: 50%;
			width: 44px;
			height: 44px;
			font-size: 1.5rem;
			cursor: pointer;
			line-height: 1;
		}
		.hero-prev { left: 2rem; }
		.hero-next { right: 2rem; }
		.hero-dots {
			position: absolute;
			bottom: 1.5rem;
			left: 50%;
			transform: translateX(-50%);
			display: flex;
			gap: 0.5rem;
		}
		.hero-dot {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: rgba(255, 255, 255, 0.3);
			border: none;
			cursor: pointer;
			padding: 0;
		}
		.hero-dot.active {
			background: var(--yellow);
		}
		.category-preview-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 1rem;
			margin: 1rem 0;
		}
		.category-preview-card {
			display: flex;
			align-items: flex-end;
			padding: 1.5rem 1rem;
			border-radius: 12px;
			text-decoration: none;
			font-weight: 700;
			font-size: 1.1rem;
			color: #FFFFFF;
			background-size: cover;
			background-position: center;
			min-height: 140px;
			transition: transform 0.2s;
		}
		.category-preview-card:hover {
			transform: translateY(-2px);
		}
		.member-preview-grid {
			display: grid;
			grid-template-columns: repeat(5, 1fr);
			gap: 0.75rem;
			margin: 1rem 0;
		}
		.member-preview-card {
			background: var(--card-bg);
			color: var(--card-text);
			border-radius: 10px;
			padding: 0.9rem 0.5rem;
			text-align: center;
		}
		.member-preview-card .member-name {
			margin: 0;
			font-size: 0.85rem;
			font-weight: 600;
		}

		@media (max-width: 700px) {
			.hero-slide {
				padding: 8rem 6vw 6rem;
			}
			.hero-slide h2 {
				font-size: 1.6rem;
			}
			.hero-arrow {
				top: auto;
				bottom: 1.5rem;
				transform: none;
				width: 36px;
				height: 36px;
				font-size: 1.25rem;
			}
			.hero-prev {
				left: auto;
				right: 4.5rem;
			}
			.hero-next {
				right: 1.5rem;
			}
			.hero-dots {
				display: none;
			}
			.category-preview-grid {
				grid-template-columns: repeat(2, 1fr);
			}
			.member-preview-grid {
				grid-template-columns: repeat(3, 1fr);
			}
		}
			.member-preview-card .member-name a {
			color: inherit;
			text-decoration: none;
		}
		.member-preview-card .member-name a:hover {
			color: #D4B876;
		}
</style>

	<script>
		const track = document.getElementById('hero-track');
		const dots = document.querySelectorAll('.hero-dot');
		const prevBtn = document.getElementById('hero-prev');
		const nextBtn = document.getElementById('hero-next');
		let current = 0;
		const total = dots.length;

		function goTo(index) {
			current = (index + total) % total;
			track.style.transform = `translateX(-${current * 100}%)`;
			dots.forEach((dot, i) => dot.classList.toggle('active', i === current));
		}

		prevBtn.addEventListener('click', () => {
			goTo(current - 1);
			resetAutoplay();
		});
		nextBtn.addEventListener('click', () => {
			goTo(current + 1);
			resetAutoplay();
		});
		dots.forEach((dot, i) => dot.addEventListener('click', () => {
			goTo(i);
			resetAutoplay();
		}));

		let autoplayTimer;
		function startAutoplay() {
			autoplayTimer = setInterval(() => goTo(current + 1), 5000);
		}
		function resetAutoplay() {
			clearInterval(autoplayTimer);
			startAutoplay();
		}

		goTo(0);
		startAutoplay();
	</script>
	<script>
		(function () {
			var KEY = 'tysda-lang-chosen';
			if (location.pathname !== '/') return;
			try {
				if (localStorage.getItem(KEY)) return;
			} catch (e) {}

			var preferEn = !/^zh/i.test(navigator.language || 'zh');

			var css = document.createElement('style');
			css.textContent =
				'.lang-gate{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:1.25rem;background:rgba(20,24,26,0.72);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);}' +
				'.lang-gate-card{width:min(92vw,380px);box-sizing:border-box;background:var(--panel-bg,#F6F0E2);color:var(--card-text,#2B2B2B);border-radius:16px;padding:1.75rem 1.5rem 1.5rem;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.45);}' +
				'.lang-gate-title{margin:0 0 0.25rem;font-size:1.15rem;font-weight:700;}' +
				'.lang-gate-sub{margin:0 0 1.4rem;font-size:0.9rem;opacity:0.7;}' +
				'.lang-gate-btn{display:block;width:100%;box-sizing:border-box;margin:0 0 0.7rem;padding:0.85rem 1rem;border-radius:10px;font-size:1rem;font-weight:600;font-family:inherit;cursor:pointer;border:1.5px solid var(--orange,#B87333);background:transparent;color:var(--orange,#B87333);transition:opacity 0.15s ease;}' +
				'.lang-gate-btn:last-child{margin-bottom:0;}' +
				'.lang-gate-btn:hover{opacity:0.85;}' +
				'.lang-gate-btn.primary{background:var(--orange,#B87333);color:#FFFFFF;}';
			document.head.appendChild(css);

			var overlay = document.createElement('div');
			overlay.className = 'lang-gate';
			overlay.setAttribute('role', 'dialog');
			overlay.setAttribute('aria-modal', 'true');
			overlay.setAttribute('aria-label', '選擇語言 Choose your language');
			overlay.innerHTML =
				'<div class="lang-gate-card">' +
				'<p class="lang-gate-title">請選擇語言</p>' +
				'<p class="lang-gate-sub">Choose your language</p>' +
				'<button type="button" class="lang-gate-btn' + (preferEn ? '' : ' primary') + '" data-lang="zh">繁體中文</button>' +
				'<button type="button" class="lang-gate-btn' + (preferEn ? ' primary' : '') + '" data-lang="en">English</button>' +
				'</div>';
			document.body.appendChild(overlay);

			var previousOverflow = document.body.style.overflow;
			document.body.style.overflow = 'hidden';

			function close() {
				document.body.style.overflow = previousOverflow;
				document.removeEventListener('keydown', onKey);
				overlay.remove();
			}
			function choose(lang) {
				try {
					localStorage.setItem(KEY, lang);
				} catch (e) {}
				if (lang === 'en') {
					location.href = '/en/';
				} else {
					close();
				}
			}
			function onKey(e) {
				if (e.key === 'Escape') close();
			}

			overlay.addEventListener('click', function (e) {
				if (e.target === overlay) close();
			});
			overlay.querySelectorAll('.lang-gate-btn').forEach(function (btn) {
				btn.addEventListener('click', function () {
					choose(btn.getAttribute('data-lang'));
				});
			});
			document.addEventListener('keydown', onKey);

			var first = overlay.querySelector('.lang-gate-btn.primary');
			if (first) first.focus();
		})();
	</script>
</Layout>
