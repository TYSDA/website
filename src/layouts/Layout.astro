---
const { title } = Astro.props;
---

<html lang="zh-Hant">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/logo2.png" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | 臺灣青少年科學發展協會</title>
		<style>
			:root {
				--bg: #1B211D;
				--panel-bg: #EFE6D8;
				--card-bg: #FFFFFF;
				--card-text: #2A2620;
				--card-text-muted: #6B6355;
				--text: #E8E9ED;
				--text-muted: #8B8F9C;
				--green: #4E9975;
				--orange: #B87333;
				--yellow: #A6863C;
				--purple: #7A6BA6;
			}
			body {
				font-family: system-ui, sans-serif;
				margin: 0;
				line-height: 1.6;
				background: var(--bg);
				color: var(--text);
			}
			a {
				color: var(--green);
			}
			h1, h2, h3 {
				color: var(--text);
			}
			.content {
				max-width: 800px;
				margin: 0 auto;
				padding: 2rem;
			}
			header {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 10;
				background: rgba(27, 33, 29, 0.6);
				backdrop-filter: blur(8px);
			}
			header .content {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding-top: 0.4rem;
				padding-bottom: 0.4rem;
			}
			.brand {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				color: inherit;
				text-decoration: none;
			}
			.brand img {
				width: 40px;
				height: 40px;
				object-fit: contain;
			}
			.brand-text {
				display: flex;
				flex-direction: column;
				line-height: 1.15;
			}
			.brand-zh {
				font-size: 1.25rem;
				font-weight: 700;
			}
			.brand-en {
				font-size: 0.7rem;
				color: var(--text-muted);
				letter-spacing: 0.02em;
			}
			nav a {
				margin-left: 1.5rem;
				color: var(--text);
				text-decoration: none;
				font-weight: 600;
				font-size: 0.95rem;
			}
			nav a:hover {
				color: var(--green);
			}
			footer {
				margin-top: 1rem;
				padding: 1.5rem 2rem;
				color: var(--text-muted);
				font-size: 0.85rem;
				max-width: 800px;
				margin-left: auto;
				margin-right: auto;
			}
			article {
				background: var(--card-bg);
				color: var(--card-text);
				border-radius: 12px;
				padding: 1.5rem;
			}
		</style>
	</head>
	<body>
		<header id="site-header">
			<div class="content">
				<a href="/" class="brand">
					<img src="/logo2.png" alt="臺灣青少年科學發展協會 logo" />
					<div class="brand-text">
						<span class="brand-zh">臺灣青少年科學發展協會</span>
						<span class="brand-en">Taiwan Young Science Development Association</span>
					</div>
				</a>
				<nav>
					<a href="/about">關於我們</a>
					<a href="/members">協會成員</a>
					<a href="/activities">協會活動</a>
					<a href="/charter">組織章程</a>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer>
			<p>© 2026 臺灣青少年科學發展協會</p>
		</footer>

		<script>
			function setHeaderHeight() {
				const header = document.getElementById('site-header');
				if (header) {
					document.documentElement.style.setProperty('--header-h', header.offsetHeight + 'px');
				}
			}
			setHeaderHeight();
			window.addEventListener('resize', setHeaderHeight);
		</script>
	</body>
</html>