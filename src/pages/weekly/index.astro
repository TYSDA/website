---
import Layout from '../../layouts/Layout.astro';

const modules = import.meta.glob('../../data/weekly/*.md', { eager: true }) as Record<string, any>;

const issues = Object.entries(modules)
	.map(([path, mod]) => ({
		slug: path.split('/').pop()!.replace(/\.md$/, ''),
		...mod.frontmatter
	}))
	.sort((a, b) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));

const seriesOrder = [...new Set(issues.map((i) => i.series))];
const groups = seriesOrder.map((s) => ({
	series: s,
	name: issues.find((i) => i.series === s)?.seriesName ?? s,
	items: issues.filter((i) => i.series === s)
}));
---

<Layout title="週報">
	<div class="panel">
		<div class="panel-inner">
			<h1 class="page-title">週報</h1>
			<p class="lead">臺灣青少年科學發展協會整理的每週科學資訊，帶你從臺灣出發，認識世界各地的展覽與最新研究。</p>

			<div class="columns">
				{groups.map((g) => (
					<section class="series">
						<h2 class="series-name">{g.name}</h2>
						<ul class="issue-list">
							{g.items.map((it) => (
								<li>
									<a class="issue-card" href={`/weekly/${it.slug}/`}>
										<div class="issue-meta">
											<span>第 {String(it.issue).padStart(3, '0')} 期</span>
											<span>{it.period ?? `${it.year} 年第 ${it.week} 週`}</span>
										</div>
										<div class="issue-title">{it.title}</div>
										<div class="issue-summary">{it.summary}</div>
									</a>
								</li>
							))}
						</ul>
					</section>
				))}
			</div>
		</div>
	</div>

	<style>
		.panel {
			background: var(--panel-bg);
			color: var(--card-text);
		}
		.panel-inner {
			max-width: 1100px;
			margin: 0 auto;
			padding: 2.5rem 2rem 4rem;
			box-sizing: border-box;
		}
		.page-title {
			font-size: 0.85rem;
			font-weight: 700;
			letter-spacing: 0.1em;
			color: var(--yellow);
			margin: 0 0 1rem;
		}
		.lead {
			line-height: 1.8;
			margin: 0 0 2rem;
			color: var(--card-text);
		}
		.columns {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
			gap: 2rem;
			align-items: start;
		}
		.series-name {
			font-size: 1.3rem;
			color: var(--card-text);
			margin: 0 0 1rem;
			padding-bottom: 0.5rem;
			border-bottom: 2px solid var(--yellow);
		}
		.issue-list {
			list-style: none;
			padding: 0;
			margin: 0;
			display: flex;
			flex-direction: column;
			gap: 0.8rem;
		}
		.issue-card {
			display: block;
			padding: 1rem 1.2rem;
			border: 1px solid rgba(42, 38, 32, 0.15);
			border-radius: 12px;
			background: var(--card-bg);
			color: inherit;
			text-decoration: none;
			transition: border-color 0.2s, box-shadow 0.2s;
		}
		.issue-card:hover {
			border-color: var(--yellow);
			box-shadow: 0 2px 10px rgba(42, 38, 32, 0.1);
		}
		.issue-meta {
			display: flex;
			flex-wrap: wrap;
			gap: 0.3rem 0.9rem;
			font-size: 0.8rem;
			color: var(--green);
			margin-bottom: 0.4rem;
		}
		.issue-title {
			font-size: 1.02rem;
			font-weight: 700;
			line-height: 1.5;
			color: var(--card-text);
			margin-bottom: 0.4rem;
		}
		.issue-summary {
			font-size: 0.88rem;
			line-height: 1.7;
			color: var(--card-text-muted);
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}
		@media (max-width: 600px) {
			.panel-inner {
				padding: 2rem 1.25rem 3rem;
			}
			.columns {
				grid-template-columns: 1fr;
			}
		}
	</style>
</Layout>
