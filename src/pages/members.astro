---
import Layout from '../layouts/Layout.astro';

const officers = [
	{ name: "（姓名）", title: "理事長" },
	{ name: "（姓名）", title: "副理事長" },
	{ name: "（姓名）", title: "副理事長" },
	{ name: "（姓名）", title: "理事" },
	{ name: "（姓名）", title: "理事" },
	{ name: "（姓名）", title: "理事" },
	{ name: "（姓名）", title: "理事" },
	{ name: "（姓名）", title: "監事" },
	{ name: "（姓名）", title: "監事" }
];

const members = Array.from({ length: 11 }, () => ({
	name: "（姓名）",
	title: "會員"
}));
---

<Layout title="協會成員">
	<div class="panel">
		<div class="panel-inner">
			<section>
				<h2>第一屆理監事成員</h2>
				<div class="member-card-grid">
					{officers.map((m) => (
						<div class="member-mini-card">
							<p class="member-name">{m.name}</p>
							<p class="member-title">{m.title}</p>
						</div>
					))}
				</div>
			</section>

			<section class="second-section">
				<h2>第一屆協會成員</h2>
				<div class="member-card-grid">
					{members.map((m) => (
						<div class="member-mini-card">
							<p class="member-name">{m.name}</p>
							<p class="member-title">{m.title}</p>
						</div>
					))}
				</div>
			</section>
		</div>
	</div>

	<style>
		.panel {
			background: var(--panel-bg);
			color: var(--card-text);
			padding-top: var(--header-h, 90px);
		}
		.panel h1, .panel h2, .panel h3 {
			color: var(--card-text);
		}
		.panel-inner {
			max-width: 800px;
			margin: 0 auto;
			padding: 2.5rem 2rem;
		}
		.second-section {
			margin-top: 2.5rem;
			padding-top: 1.5rem;
			border-top: 1px solid #DDD2BE;
		}
		.member-card-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
			gap: 0.75rem;
			margin-top: 1rem;
		}
		.member-mini-card {
			background: var(--card-bg);
			color: var(--card-text);
			border-radius: 10px;
			padding: 0.9rem 0.5rem;
			text-align: center;
		}
		.member-mini-card .member-name {
			margin: 0 0 0.2rem;
			font-size: 0.9rem;
			font-weight: 600;
		}
		.member-mini-card .member-title {
			margin: 0;
			font-size: 0.75rem;
			color: var(--orange);
		}
	</style>
</Layout>