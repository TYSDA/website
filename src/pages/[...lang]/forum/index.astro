---
import Layout from '../../../layouts/Layout.astro';
import { getLangFromUrl, localizePath } from '../../../i18n/ui';

export function getStaticPaths() {
	return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}

const lang = getLangFromUrl(Astro.url);

const content = {
	zh: {
		pageTitle: '臺灣青少年科學發展論壇',
		heading: '臺灣青少年科學發展論壇',
		intro:
			'由臺灣青少年科學發展協會主辦，邀請青年科學家、大學生、國高中教師與大學教授跨世代對談，\n促進青少年科學研究與學研風氣。',
		edition: '第一屆',
		cardTitle: '2026 臺灣青少年科學發展論壇',
		cardDate: '2026年12月25日－12月26日・國立臺灣科學教育館'
	},
	en: {
		pageTitle: 'Taiwan Young Science Development Forum',
		heading: 'Taiwan Young Science Development Forum',
		intro:
			'Organized by the Taiwan Young Science Development Association, the forum brings together young scientists, university students, junior and senior high school teachers, and university professors for cross-generational conversation,\npromoting science research among young people and a culture of academic inquiry.',
		edition: '1st Edition',
		cardTitle: '2026 Taiwan Young Science Development Forum',
		cardDate: 'December 25–26, 2026 · National Taiwan Science Education Center'
	}
};

const c = content[lang];
---

<Layout title={c.pageTitle}>
	<div class="panel">
		<div class="panel-inner">
			<h2>{c.heading}</h2>
			<p>{c.intro}</p>

			<div class="forum-editions">
				<a href={localizePath('/forum/2026', lang)} class="forum-edition-card">
					<span class="edition-tag">{c.edition}</span>
					<h3>{c.cardTitle}</h3>
					<p>{c.cardDate}</p>
				</a>
			</div>
		</div>
	</div>

	<style>
		.panel {
			background: var(--panel-bg);
			color: var(--card-text);
			padding-top: var(--header-h, 90px);
		}
		.panel h1, .panel h2, .panel h3 {
			color: var(--card-text);
		}
		.panel-inner {
			max-width: 800px;
			margin: 0 auto;
			padding: 2.5rem 2rem;
		}
		.forum-editions {
			margin-top: 2rem;
		}
		.forum-edition-card {
			display: block;
			background: var(--card-bg);
			border-radius: 12px;
			padding: 1.5rem;
			text-decoration: none;
			color: var(--card-text);
			border: 1px solid transparent;
			transition: border-color 0.2s;
		}
		.forum-edition-card:hover {
			border-color: var(--orange);
		}
		.edition-tag {
			display: inline-block;
			background: rgba(184, 115, 51, 0.15);
			color: var(--orange);
			font-size: 0.8rem;
			font-weight: 600;
			padding: 0.2rem 0.7rem;
			border-radius: 999px;
			margin-bottom: 0.5rem;
		}
		.forum-edition-card h3 {
			margin: 0 0 0.4rem;
		}
		.forum-edition-card p {
			margin: 0;
			color: var(--card-text-muted);
			font-size: 0.9rem;
		}
	</style>
</Layout>
