---
import Layout from '../../../layouts/Layout.astro';

const steps = [
	{ time: "STEP 1", tag: "匯款", title: "完成報名費匯款", desc: "請依下方資訊完成匯款，並記下帳號後五碼、日期與金額。" },
	{ time: "STEP 2", tag: "填表", title: "填寫線上報名表單", desc: "匯款完成後，請填寫表單並附上匯款資訊，完成初步報名。" },
	{ time: "STEP 3", tag: "確認", title: "等待報名成功通知", desc: "我們將於確認匯款後以 Email 通知，屆時報名才正式完成。" }
];
---

<Layout title="立即報名 | 第一屆臺灣青少年科學發展論壇">
	<a href="/forum/2026" class="back-fab" aria-label="返回論壇詳情">←</a>

	<div class="panel">
		<div class="starfield"></div>
		<div class="panel-inner">
			<div class="page-title-row">
				<h1 class="page-title">立即報名</h1>
				<p class="time-hint" id="price-hint">名額有限，額滿即止。</p>
			</div>

			<div class="vline">
				{steps.map((s) => (
					<div class="vnode">
						<div class="vnode-marker">
							<span class="vnode-dot"></span>
						</div>
						<div class="vnode-body">
							<div class="vnode-time-tag">
								<span class="vnode-time">{s.time}</span>
								<span class="vnode-tag">{s.tag}</span>
							</div>
							<div class="vnode-card">
								<p class="vnode-title">{s.title}</p>
								<p class="vnode-desc">{s.desc}</p>
							</div>
						</div>
					</div>
				))}
			</div>

			<div class="payment-info">
				<h3>匯款資訊</h3>
				<p><span class="payment-label">銀行代號</span>700（郵局）</p>
				<p><span class="payment-label">帳號</span>0021532 0473660</p>
				<p><span class="payment-label">戶名</span>臺灣青少年科學發展協會關貫之</p>
				<p><span class="payment-label">郵局</span>臺中淡溝郵局</p>
				<p class="fee-note" id="fee-note">費用資訊載入中...</p>
			</div>

			<a href="/forum/2026/register/form" class="register-button">前往報名表單</a>
		</div>
	</div>

	<style>
		.back-fab {
			position: fixed;
			top: calc(var(--header-h, 74px) + 1.25rem);
			left: 2rem;
			width: 42px;
			height: 42px;
			border-radius: 50%;
			background: rgba(255,255,255,0.1);
			backdrop-filter: blur(8px);
			border: 1px solid rgba(255,255,255,0.2);
			color: #E8E9ED;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 1.2rem;
			text-decoration: none;
			z-index: 20;
			transition: background 0.2s;
		}
		.back-fab:hover {
			background: rgba(255,255,255,0.2);
		}
		.panel {
			position: relative;
			background: #14181A;
			color: var(--text);
			overflow: hidden;
			box-sizing: border-box;
		}
		.starfield {
			position: absolute;
			inset: 0;
			background-image:
				radial-gradient(1px 1px at 20% 30%, rgba(212,184,118,0.4), transparent),
				radial-gradient(1px 1px at 70% 15%, rgba(212,184,118,0.3), transparent),
				radial-gradient(1px 1px at 40% 70%, rgba(212,184,118,0.35), transparent),
				radial-gradient(1px 1px at 85% 60%, rgba(212,184,118,0.25), transparent),
				radial-gradient(1px 1px at 10% 85%, rgba(212,184,118,0.3), transparent);
			pointer-events: none;
		}
		.panel-inner {
			position: relative;
			max-width: 800px;
			width: 100%;
			margin: 0 auto;
			padding: 2.5rem 2rem 4rem;
			box-sizing: border-box;
		}
		.page-title-row {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			flex-wrap: wrap;
			gap: 0.5rem 1.5rem;
			margin: 0 0 2.5rem;
		}
		.page-title {
			font-size: 0.85rem;
			font-weight: 700;
			letter-spacing: 0.1em;
			color: #D4B876;
			margin: 0;
		}
		.time-hint {
			font-size: 0.85rem;
			color: #D4B876;
			font-weight: 600;
			margin: 0;
		}
		.vline {
			position: relative;
			padding-left: 2rem;
			margin-bottom: 2.5rem;
		}
		.vline::before {
			content: "";
			position: absolute;
			left: 5px;
			top: 10px;
			bottom: 10px;
			width: 2px;
			background: linear-gradient(180deg, rgba(212,184,118,0.5), rgba(212,184,118,0.05));
		}
		.vnode {
			position: relative;
			display: flex;
			gap: 1.25rem;
			margin-bottom: 2rem;
		}
		.vnode:last-child {
			margin-bottom: 0;
		}
		.vnode-marker {
			position: absolute;
			left: -2rem;
			top: 0.4rem;
		}
		.vnode-dot {
			display: block;
			width: 12px;
			height: 12px;
			border-radius: 50%;
			background: #D4B876;
			box-shadow: 0 0 10px 3px rgba(212, 184, 118, 0.6);
		}
		.vnode-body {
			flex: 1;
			min-width: 0;
		}
		.vnode-time-tag {
			display: flex;
			align-items: baseline;
			gap: 0.6rem;
			margin-bottom: 0.5rem;
			transform: skewX(-8deg);
			transform-origin: left;
		}
		.vnode-time {
			font-size: 0.85rem;
			font-weight: 700;
			color: #D4B876;
			letter-spacing: 0.03em;
		}
		.vnode-tag {
			font-size: 0.75rem;
			color: #7C8090;
			letter-spacing: 0.05em;
		}
		.vnode-card {
			background: rgba(212, 184, 118, 0.08);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			border: 1px solid rgba(212, 184, 118, 0.25);
			border-radius: 12px;
			padding: 1rem 1.15rem;
			box-shadow:
				0 0 0 1px rgba(212, 184, 118, 0.08),
				0 0 20px rgba(212, 184, 118, 0.1);
			box-sizing: border-box;
		}
		.vnode-title {
			font-size: 0.98rem;
			font-weight: 600;
			color: #F0F0F0;
			margin: 0 0 0.4rem;
			line-height: 1.4;
			overflow-wrap: break-word;
		}
		.vnode-desc {
			font-size: 0.85rem;
			color: #A8ACBA;
			margin: 0;
			line-height: 1.6;
			overflow-wrap: break-word;
		}
		.payment-info {
			position: relative;
			background: rgba(212, 184, 118, 0.06);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			border: 1px solid rgba(212, 184, 118, 0.25);
			border-radius: 14px;
			padding: 1.5rem;
			margin-bottom: 2rem;
			box-shadow:
				0 0 0 1px rgba(212, 184, 118, 0.08),
				0 0 24px rgba(212, 184, 118, 0.08);
			box-sizing: border-box;
			width: 100%;
		}
		.payment-info h3 {
			margin: 0 0 1.1rem;
			color: #D4B876;
			font-size: 1rem;
		}
		.payment-info p {
			margin: 0.55rem 0;
			font-size: 0.98rem;
			color: #E8E9ED;
			display: flex;
			gap: 0.75rem;
			overflow-wrap: break-word;
		}
		.payment-label {
			flex-shrink: 0;
			width: 5.5rem;
			color: #A8ACBA;
			font-size: 0.85rem;
		}
		.fee-note {
			margin-top: 0.9rem !important;
			padding-top: 0.9rem;
			border-top: 1px solid rgba(212, 184, 118, 0.2);
			font-size: 0.9rem !important;
			color: #D4B876 !important;
			font-weight: 600;
			overflow-wrap: break-word;
			word-break: break-word;
			display: block;
		}
		.register-button {
			position: relative;
			display: block;
			width: fit-content;
			margin-left: auto;
			background: #D4B876;
			color: #14181A;
			padding: 0.9rem 2.5rem;
			border-radius: 8px;
			font-weight: 700;
			text-decoration: none;
			box-shadow: 0 0 24px rgba(212, 184, 118, 0.35);
			box-sizing: border-box;
		}
		.register-button:hover {
			opacity: 0.9;
		}

		@media (max-width: 700px) {
			.back-fab {
				left: 1.25rem;
				width: 36px;
				height: 36px;
				font-size: 1.05rem;
				top: calc(var(--header-h, 74px) + 0.75rem);
			}
			.page-title {
				font-size: 0.7rem;
			}
		}
		@media (max-width: 600px) {
			.vnode-title {
				font-size: 0.9rem;
			}
			.vnode-desc {
				font-size: 0.8rem;
			}
			.payment-info p {
				flex-direction: column;
				gap: 0.15rem;
			}
			.payment-label {
				width: auto;
			}
			.register-button {
				margin-left: 0;
				width: 100%;
				text-align: center;
			}
		}
	</style>

	<script>
		const footer = document.querySelector('footer');
		if (footer) {
			footer.style.display = 'none';
		}

		const EARLY_BIRD_DEADLINE = new Date('2026-10-15T23:59:59+08:00');
		const EARLY_BIRD_PRICE = 800;
		const REGULAR_PRICE = 1200;

		function getCurrentFee() {
			return new Date() <= EARLY_BIRD_DEADLINE ? EARLY_BIRD_PRICE : REGULAR_PRICE;
		}

		const feeNote = document.getElementById('fee-note');
		if (feeNote) {
			const fee = getCurrentFee();
			const isEarlyBird = fee === EARLY_BIRD_PRICE;
			feeNote.textContent = isEarlyBird
				? `報名費 NT$${fee}（含兩日午餐、科教館門票）・早鳥價至 10/15 止`
				: `報名費 NT$${fee}（含兩日午餐、科教館門票）・已超過早鳥期限`;
		}

		const priceHint = document.getElementById('price-hint');
		if (priceHint) {
			const fee = getCurrentFee();
			priceHint.textContent = `名額有限，額滿即止・目前報名費 NT$${fee}`;
		}
	</script>
</Layout>
