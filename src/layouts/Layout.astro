---
import {
	getLangFromUrl,
	useTranslations,
	stripLang,
	localizePath,
	translatedPaths,
	type Lang
} from '../i18n/ui';

const { title } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const cleanPath = stripLang(Astro.url.pathname);
const targetLang: Lang = lang === 'en' ? 'zh' : 'en';
const switchHref =
	targetLang === 'en' && !translatedPaths.has(cleanPath)
		? '/en/'
		: localizePath(cleanPath, targetLang);

const hasEnglish = translatedPaths.has(cleanPath);
const zhHref = new URL(localizePath(cleanPath, 'zh'), Astro.url.origin).toString();
const enHref = new URL(localizePath(cleanPath, 'en'), Astro.url.origin).toString();
---

<html lang={lang === 'en' ? 'en' : 'zh-Hant'}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/logo2.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {t('brand.main')}</title>
    {hasEnglish && <link rel="alternate" hreflang="zh-Hant" href={zhHref} />}
    {hasEnglish && <link rel="alternate" hreflang="en" href={enHref} />}

    <style>
      :root {
        --bg: #1b211d;
        --panel-bg: #efe6d8;
        --card-bg: #ffffff;
        --card-text: #2a2620;
        --card-text-muted: #6b6355;
        --text: #e8e9ed;
        --text-muted: #b4b8c0;

        --green: #4e9975;
        --orange: #b87333;
        --yellow: #a6863c;
        --purple: #7a6ba6;

        --header-h: 74px;
      }

      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family:
          "Noto Sans TC",
          "PingFang TC",
          "Microsoft JhengHei",
          system-ui,
          sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }

      a {
        color: var(--green);
      }

      h1,
      h2,
      h3 {
        color: var(--text);
      }

      main {
        min-height: 100vh;
        padding-top: var(--header-h);
      }

      /* ===========================
         一般內容容器
      ============================ */

      .content {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
      }

      article {
        background: var(--card-bg);
        color: var(--card-text);
        border-radius: 14px;
        padding: 1.5rem;
      }

      /* ===========================
         Header
      ============================ */

      header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 999;

        background: rgba(27, 33, 29, 0.45);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);

        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        transition:
          background 0.35s ease,
          backdrop-filter 0.35s ease,
          border-color 0.35s ease;
      }

      header.scrolled {
        background: rgba(27, 33, 29, 0.82);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      }

      .header-content {
        width: min(1400px, calc(100% - 48px));
        margin: 0 auto;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;

        height: var(--header-h);
      }

      /* ===========================
         Logo
      ============================ */

      .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;

        color: inherit;
        text-decoration: none;

        flex-shrink: 0;
        min-width: 0;
        height: 100%;
      }

      .brand img {
        width: clamp(38px, 2vw, 48px);
        height: clamp(38px, 2vw, 48px);
        object-fit: contain;
        display: block;
      }

      .brand-text {
        display: flex;
        flex-direction: column;
        justify-content: center;
        line-height: 1.1;
        min-width: 0;
      }

      .brand-zh {
        font-size: clamp(1rem, 1vw + 0.6rem, 1.3rem);
        font-weight: 700;
        white-space: nowrap;
      }

      /* 英文版：主標題是英文全名，允許換行 */
      .brand-zh.is-en {
        white-space: normal;
        font-size: clamp(0.8rem, 0.5vw + 0.6rem, 1rem);
        line-height: 1.15;
        max-width: 22rem;
      }

      .brand-en {
        font-size: 0.72rem;
        color: var(--text-muted);
        letter-spacing: 0.04em;
        white-space: nowrap;
      }

      /* ===========================
         Desktop Nav
      ============================ */

      nav {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: clamp(1rem, 2vw, 2.5rem);
        flex-wrap: nowrap;
      }

      nav a {
        color: var(--text);
        text-decoration: none;
        font-weight: 600;
        font-size: clamp(0.9rem, 0.5vw + 0.8rem, 1rem);
        position: relative;
        transition: color 0.25s ease;
      }

      nav a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -6px;
        width: 100%;
        height: 2px;
        background: var(--green);

        transform: scaleX(0);
        transform-origin: center;
        transition: transform 0.25s ease;
      }

      nav a:hover {
        color: #7bd0a7;
      }

      nav a:hover::after {
        transform: scaleX(1);
      }

      /* 語言切換按鈕 */
      nav a.lang-switch {
        border: 1px solid rgba(255, 255, 255, 0.28);
        border-radius: 999px;
        padding: 0.2rem 0.85rem;
        font-size: 0.85rem;
        letter-spacing: 0.04em;
      }

      nav a.lang-switch::after {
        display: none;
      }

      nav a.lang-switch:hover {
        border-color: #7bd0a7;
      }

      /* ===========================
         Mobile Menu Button
      ============================ */

      .menu-toggle {
        display: none;

        background: none;
        border: none;
        color: var(--text);

        font-size: 1.8rem;
        cursor: pointer;

        padding: 0;
        line-height: 1;
      }

      /* ===========================
         Footer
      ============================ */

      footer {
        max-width: 1400px;
        margin: 0 auto;
        padding: 2rem 24px;
        color: var(--text-muted);
        font-size: 0.85rem;
      }

      /* ===========================
         Responsive
      ============================ */

      @media (max-width: 900px) {
        .header-content {
          width: calc(100% - 32px);
          gap: 1rem;
        }

        .brand-zh {
          font-size: 0.95rem;
        }

        .brand-zh.is-en {
          font-size: 0.78rem;
          max-width: 11.5rem;
        }

        .brand-en {
          display: none;
        }

        .menu-toggle {
          display: block;
        }

        nav {
          display: flex;
          flex-direction: column;
          align-items: stretch;

          position: absolute;
          top: var(--header-h);
          left: 0;
          right: 0;

          background: rgba(27, 33, 29, 0.96);
          backdrop-filter: blur(18px);
          -webkit-backdrop-filter: blur(18px);

          padding: 0 24px;
          gap: 0;

          max-height: 0;
          overflow: hidden;

          transition: max-height 0.28s ease;
        }

        nav.open {
          max-height: 420px;
        }

        nav a {
          padding: 0.95rem 0;
          border-bottom: 1px solid rgba(255, 255, 255, 0.08);
          font-size: 1rem;
        }

        nav a::after {
          display: none;
        }

        nav a.lang-switch {
          border: none;
          border-bottom: 1px solid rgba(255, 255, 255, 0.08);
          border-radius: 0;
          padding: 0.95rem 0;
          font-size: 1rem;
        }
      }

      @media (max-width: 480px) {
        .header-content {
          width: calc(100% - 24px);
        }

        .brand img {
          width: 36px;
          height: 36px;
        }

        .brand-zh {
          font-size: 0.88rem;
        }

        .brand-zh.is-en {
          font-size: 0.72rem;
          max-width: 10rem;
        }
      }
    </style>
  </head>

  <body>
    <header id="site-header">
      <div class="header-content">
        <a href={localizePath('/', lang)} class="brand">
          <img src="/logo2.png" alt={t('logo.alt')} />

          <div class="brand-text">
            <span class:list={['brand-zh', { 'is-en': lang === 'en' }]}>
              {t('brand.main')}
            </span>
            <span class="brand-en">
              {t('brand.sub')}
            </span>
          </div>
        </a>

        <button
          class="menu-toggle"
          id="menu-toggle"
          aria-label={t('menu.open')}
          aria-expanded="false"
        >
          ☰
        </button>

        <nav id="site-nav">
          <a href={localizePath('/about', lang)}>{t('nav.about')}</a>
          <a href={localizePath('/members', lang)}>{t('nav.members')}</a>
          <a href={localizePath('/activities', lang)}>{t('nav.activities')}</a>
          <a href={localizePath('/charter', lang)}>{t('nav.charter')}</a>
          <a
            href={switchHref}
            class="lang-switch"
            hreflang={targetLang === 'en' ? 'en' : 'zh-Hant'}
            aria-label={t('lang.switchLabel')}
          >
            {t('lang.switch')}
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>{t('footer.copyright')}</p>
    </footer>

    <script>
      const header = document.getElementById("site-header");
      const menuToggle = document.getElementById("menu-toggle");
      const siteNav = document.getElementById("site-nav");

      /* Header 滾動玻璃效果 */
      const handleScroll = () => {
        header.classList.toggle("scrolled", window.scrollY > 40);
      };

      handleScroll();
      window.addEventListener("scroll", handleScroll, { passive: true });

      /* 手機選單 */
      menuToggle?.addEventListener("click", () => {
        const opened = siteNav.classList.toggle("open");

        menuToggle.setAttribute("aria-expanded", String(opened));
        menuToggle.textContent = opened ? "✕" : "☰";
      });

      /* 點選選單後自動收起（手機） */
      siteNav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          siteNav.classList.remove("open");
          menuToggle.textContent = "☰";
          menuToggle.setAttribute("aria-expanded", "false");
        });
      });
    </script>
  </body>
</html>