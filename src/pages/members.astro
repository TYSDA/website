---
import Layout from '../layouts/Layout.astro';

const officers = [
	{ name: "（姓名）", title: "理事長" },
	{ name: "（姓名）", title: "副理事長" },
	{ name: "（姓名）", title: "副理事長" },
	{ name: "（姓名）", title: "理事" },
	{ name: "（姓名）", title: "理事" },
	{ name: "（姓名）", title: "理事" },
	{ name: "（姓名）", title: "理事" },
	{ name: "（姓名）", title: "監事" },
	{ name: "（姓名）", title: "監事" }
];

const members = Array.from({ length: 11 }, () => ({
	name: "（姓名）",
	title: "會員"
}));
---

<Layout title="理監事成員">
	<div class="panel">
		<div class="panel-inner">
			<section>
				<h2>第一屆理監事成員</h2>
				<div class="member-grid">
					{officers.map((m) => (
						<div class="member-card">
							<img src="/logo.png" alt={m.name} class="member-photo" />
							<h3>{m.name}</h3>
							<p class="member-title">{m.title}</p>
						</div>
					))}
				</div>
			</section>

			<section class="second-section">
				<h2>第一屆協會成員</h2>
				<div class="member-grid">
					{members.map((m) => (
						<div class="member-card">
							<img src="/logo.png" alt={m.name} class="member-photo" />
							<h3>{m.name}</h3>
							<p class="member-title">{m.title}</p>
						</div>
					))}
				</div>
			</section>
		</div>
	</div>

	<style>
		.panel {
			background: var(--panel-bg);
			color: var(--card-text);
			margin-top: -6rem;
			padding-top: 6rem;
		}
		.panel h1, .panel h2, .panel h3 {
			color: var(--card-text);
		}
		.panel-inner {
			max-width: 800px;
			margin: 0 auto;
			padding: 2.5rem 2rem;
		}
		.second-section {
			margin-top: 2.5rem;
			padding-top: 1.5rem;
			border-top: 1px solid #DDD2BE;
		}
		.member-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
			gap: 1.5rem;
			margin-top: 1.5rem;
		}
		.member-card {
			text-align: center;
			background: var(--card-bg);
			color: var(--card-text);
			border-radius: 12px;
			padding: 1.25rem 1rem;
		}
		.member-photo {
			width: 100px;
			height: 100px;
			border-radius: 50%;
			object-fit: cover;
			background: #1B211D;
			margin: 0 auto 0.75rem;
			display: block;
		}
		.member-card h3 {
			margin: 0 0 0.25rem;
			font-size: 0.95rem;
			color: var(--card-text);
		}
		.member-title {
			color: var(--orange);
			font-size: 0.8rem;
			margin: 0;
		}
	</style>
</Layout>