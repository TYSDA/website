---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
	const modules = import.meta.glob('../../data/weekly/*.md', { eager: true }) as Record<string, any>;
	const issues = Object.entries(modules)
		.map(([path, mod]) => ({
			slug: path.split('/').pop()!.replace(/\.md$/, ''),
			mod
		}))
		.sort((a, b) =>
			a.mod.frontmatter.date < b.mod.frontmatter.date ? 1 : a.mod.frontmatter.date > b.mod.frontmatter.date ? -1 : 0
		);

	return issues.map((it, idx) => {
		const older = issues[idx + 1];
		const newer = issues[idx - 1];
		return {
			params: { slug: it.slug },
			props: {
				mod: it.mod,
				older: older && older.mod.frontmatter.series === it.mod.frontmatter.series
					? { slug: older.slug, title: older.mod.frontmatter.title, issue: older.mod.frontmatter.issue }
					: null,
				newer: newer && newer.mod.frontmatter.series === it.mod.frontmatter.series
					? { slug: newer.slug, title: newer.mod.frontmatter.title, issue: newer.mod.frontmatter.issue }
					: null
			}
		};
	});
}

const { mod, older, newer } = Astro.props;
const fm = mod.frontmatter;
const Content = mod.Content;
const issueNo = String(fm.issue).padStart(3, '0');
---

<Layout title={`${fm.seriesName} 第 ${issueNo} 期`}>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;900&display=swap" />

	<div class="panel">
		<article class="paper">
			<a class="back" href="/weekly/">← 週報列表</a>

			<header class="masthead">
				<div class="mast-top">
					<span>臺灣青少年科學發展協會 編</span>
					<span>第 {issueNo} 期</span>
					<span>{fm.year} 年第 {fm.week} 週</span>
				</div>
				<div class="mast-name">{fm.seriesName}</div>
				<div class="mast-date">{fm.period ?? `編輯日期　${fm.date}`}</div>
			</header>

			<h1 class="headline">{fm.title}</h1>

			<div class="weekly-body">
				<Content />
			</div>

			<nav class="pager" aria-label="上一期與下一期">
				{older ? (
					<a href={`/weekly/${older.slug}/`}>
						<span class="pager-label">← 上一期（第 {String(older.issue).padStart(3, '0')} 期）</span>
						<span class="pager-title">{older.title}</span>
					</a>
				) : <span></span>}
				{newer ? (
					<a class="pager-next" href={`/weekly/${newer.slug}/`}>
						<span class="pager-label">下一期（第 {String(newer.issue).padStart(3, '0')} 期） →</span>
						<span class="pager-title">{newer.title}</span>
					</a>
				) : <span></span>}
			</nav>
		</article>
	</div>

	<style>
		.panel {
			background: var(--panel-bg);
			color: var(--card-text);
			padding: 1.5rem 1rem 3rem;
		}
		.paper {
			--ink: #2a2620;
			--ink-soft: #6b6355;
			--rule: rgba(42, 38, 32, 0.35);
			--serif: "Noto Serif TC", "Songti TC", "Source Han Serif TC", "PMingLiU", "Georgia", serif;
			max-width: 1040px;
			margin: 0 auto;
			padding: 1.25rem 2.25rem 2.5rem;
			background: #f7f1e3;
			border: 1px solid var(--rule);
			box-shadow: 0 2px 14px rgba(42, 38, 32, 0.12);
			color: var(--ink);
			font-family: var(--serif);
			box-sizing: border-box;
		}
		.back {
			display: inline-block;
			font-family: var(--font-sans, inherit);
			font-size: 0.85rem;
			color: var(--ink-soft);
			text-decoration: none;
			margin-bottom: 0.9rem;
		}
		.back:hover {
			text-decoration: underline;
		}

		/* 報頭 */
		.masthead {
			text-align: center;
			border-top: 4px solid var(--ink);
			border-bottom: 1px solid var(--ink);
			padding: 0.5rem 0 0.9rem;
		}
		.mast-top {
			display: flex;
			justify-content: space-between;
			gap: 0.5rem;
			font-size: 0.8rem;
			letter-spacing: 0.08em;
			color: var(--ink-soft);
			padding-bottom: 0.5rem;
			border-bottom: 1px solid var(--rule);
		}
		.mast-name {
			font-size: clamp(2.2rem, 7vw, 3.8rem);
			font-weight: 900;
			letter-spacing: 0.2em;
			text-indent: 0.2em;
			line-height: 1.25;
			padding: 0.7rem 0 0.4rem;
		}
		.mast-date {
			display: inline-block;
			font-size: 0.9rem;
			letter-spacing: 0.15em;
			padding: 0.2rem 1.2rem;
			border-top: 1px solid var(--ink);
			border-bottom: 1px solid var(--ink);
		}

		/* 頭條 */
		.headline {
			font-family: var(--serif);
			font-size: clamp(1.45rem, 3.6vw, 2.1rem);
			font-weight: 900;
			line-height: 1.45;
			text-align: center;
			color: var(--ink);
			margin: 1.4rem auto 1.4rem;
			max-width: 36em;
			text-wrap: balance;
		}

		/* 內文：報紙式雙欄 */
		.weekly-body {
			font-size: 1rem;
		}
		.weekly-body :global(.cols) {
			column-count: 2;
			column-gap: 2.4rem;
			column-rule: 1px solid var(--rule);
		}
		.weekly-body :global(h2) {
			margin: 1.8rem 0 1rem;
			padding: 0.4rem 0.9rem;
			background: var(--ink);
			color: #f7f1e3;
			font-size: 1.05rem;
			font-weight: 600;
			letter-spacing: 0.18em;
			break-after: avoid;
		}
		.weekly-body :global(h2:first-child) {
			margin-top: 0;
		}
		.weekly-body :global(h3) {
			margin: 1.5rem 0 0.4rem;
			padding-top: 0.7rem;
			border-top: 1px solid var(--ink);
			font-size: 1.18rem;
			font-weight: 900;
			line-height: 1.5;
			color: var(--ink);
			break-after: avoid;
			break-inside: avoid;
		}
		.weekly-body :global(p) {
			margin: 0 0 0.85rem;
			line-height: 1.9;
			text-align: justify;
			text-indent: 2em;
			orphans: 2;
			widows: 2;
			overflow-wrap: anywhere;
		}
		/* 報導的出處行（國家｜館名） */
		.weekly-body :global(p:has(> em:only-child)) {
			text-indent: 0;
			text-align: left;
			font-size: 0.82rem;
			letter-spacing: 0.06em;
			color: var(--ink-soft);
			margin: 0 0 0.7rem;
		}
		.weekly-body :global(em) {
			font-style: normal;
		}
		.weekly-body :global(p:has(> strong:only-child)) {
			text-indent: 0;
			text-align: left;
			font-size: 0.92rem;
			letter-spacing: 0.05em;
			margin-bottom: 0.3rem;
		}
		.weekly-body :global(strong) {
			font-weight: 900;
		}
		/* 論文引用（英文）靠左，避免兩端對齊把字距拉太開 */
		.weekly-body :global(p:has(> strong:only-child) + p) {
			text-align: left;
			text-indent: 0;
			font-size: 0.9rem;
			color: var(--ink-soft);
		}
		/* 圖片與圖說 */
		.weekly-body :global(p:has(> img)) {
			text-indent: 0;
			margin: 0.3rem 0 0.2rem;
			break-inside: avoid;
		}
		.weekly-body :global(img) {
			display: block;
			width: 100%;
			height: auto;
			max-height: 520px;
			object-fit: contain;
			background: #e9e1cf;
			border: 1px solid var(--rule);
		}
		.weekly-body :global(p:has(> img) + p:has(> em:only-child)) {
			text-align: right;
			font-size: 0.75rem;
			margin-bottom: 0.9rem;
		}
		.weekly-body :global(ul) {
			margin: 0 0 0.9rem;
			padding-left: 1.2rem;
		}
		.weekly-body :global(li) {
			line-height: 1.85;
			margin-bottom: 0.7rem;
			text-align: justify;
		}
		.weekly-body :global(a) {
			color: var(--ink);
			text-decoration: underline;
			text-decoration-style: dotted;
			text-underline-offset: 3px;
			overflow-wrap: anywhere;
		}
		.weekly-body :global(a:hover) {
			text-decoration-style: solid;
		}
		.weekly-body :global(hr) {
			border: 0;
			border-top: 3px double var(--ink);
			margin: 2rem 0 1rem;
		}

		.pager {
			display: flex;
			justify-content: space-between;
			gap: 1.5rem;
			margin-top: 2.5rem;
			padding-top: 1rem;
			border-top: 4px double var(--ink);
		}
		.pager a {
			flex: 1 1 0;
			min-width: 0;
			display: flex;
			flex-direction: column;
			gap: 0.3rem;
			color: inherit;
			text-decoration: none;
		}
		.pager-next {
			text-align: right;
		}
		.pager-label {
			font-size: 0.8rem;
			color: var(--ink-soft);
			letter-spacing: 0.05em;
		}
		.pager-title {
			font-size: 0.95rem;
			font-weight: 600;
			line-height: 1.5;
		}
		.pager a:hover .pager-title {
			text-decoration: underline;
		}

		@media (max-width: 860px) {
			.paper {
				padding: 1rem 1.25rem 2rem;
			}
			.weekly-body :global(.cols) {
				column-count: 1;
			}
			.mast-top {
				font-size: 0.72rem;
			}
		}
		@media (max-width: 600px) {
			.panel {
				padding: 0.75rem 0.5rem 2rem;
			}
			.pager {
				flex-direction: column;
			}
			.pager-next {
				text-align: left;
			}
		}
	</style>
</Layout>
