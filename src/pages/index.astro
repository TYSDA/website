---
import Layout from '../layouts/Layout.astro';

const slides = [
	{
		label: "最新活動",
		title: "第一屆臺灣青少年科學發展論壇",
		date: "2026年12月25日－12月26日・國立臺灣科學教育館",
		link: "/activities/forum"
	},
	{
		label: "會員通知",
		title: "第一屆第二次會員大會",
		date: "2026年8月30日（日）16:00・喝點兒小酒 風味小館",
		link: "/activities/assembly"
	}
];

const categories = [
	{ name: "論壇", link: "/activities#forum", bg: "/forum.png" },
	{ name: "課程", link: "/activities#course", bg: "/lecture.png" },
	{ name: "工作坊", link: "/activities#workshop", bg: "/workshop.png" },
	{ name: "會員活動", link: "/activities#assembly", bg: "/assembly.png" }
];
---

<Layout title="首頁">
	<div class="hero-carousel">
		<div class="hero-track" id="hero-track">
			{slides.map((s) => (
				<a href={s.link} class="hero-slide">
					<p class="hero-label">{s.label}</p>
					<h2>{s.title}</h2>
					<p class="hero-date">{s.date}</p>
					<span class="hero-cta">查看詳情 →</span>
				</a>
			))}
		</div>
		<button class="hero-arrow hero-prev" id="hero-prev" aria-label="上一張">‹</button>
		<button class="hero-arrow hero-next" id="hero-next" aria-label="下一張">›</button>
		<div class="hero-dots" id="hero-dots">
			{slides.map((_, i) => (
				<button class="hero-dot" data-index={i} aria-label={`第 ${i + 1} 張`}></button>
			))}
		</div>
	</div>

	<div class="panel">
		<div class="panel-inner">
			<p>
				我們相信每一位對科學充滿好奇的青少年，都值得公平獲取學術與研究資源的機會。
				在這裡，你可以認識我們的團隊、瀏覽最新活動，一起探索科學的世界。
			</p>
		</div>
	</div>

	<div class="panel">
		<div class="panel-inner">
			<h2>協會活動</h2>
			<div class="category-preview-grid">
				{categories.map((cat) => (
					<a href={cat.link} class="category-preview-card" style={`background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url(${cat.bg})`}>
						{cat.name}
					</a>
				))}
			</div>
			<a href="/activities">查看所有活動 →</a>
		</div>
	</div>

	<div class="panel">
		<div class="panel-inner">
			<h2>協會成員</h2>
			<div class="member-preview-grid">
				<div class="member-preview-item">
					<img src="/logo2.png" alt="（姓名）" class="member-photo" />
					<p class="member-name">（姓名）</p>
				</div>
				<div class="member-preview-item">
					<img src="/logo2.png" alt="（姓名）" class="member-photo" />
					<p class="member-name">（姓名）</p>
				</div>
				<div class="member-preview-item">
					<img src="/logo2.png" alt="（姓名）" class="member-photo" />
					<p class="member-name">（姓名）</p>
				</div>
				<div class="member-preview-item">
					<img src="/logo2.png" alt="（姓名）" class="member-photo" />
					<p class="member-name">（姓名）</p>
				</div>
				<div class="member-preview-item">
					<img src="/logo2.png" alt="（姓名）" class="member-photo" />
					<p class="member-name">（姓名）</p>
				</div>
			</div>
			<a href="/members">查看全部成員 →</a>
		</div>
	</div>

	<style>
		.panel {
			background: var(--panel-bg);
			color: var(--card-text);
			margin-bottom: 1.5rem;
		}
		.panel h1, .panel h2, .panel h3 {
			color: var(--card-text);
		}
		.panel-inner {
			max-width: 800px;
			margin: 0 auto;
			padding: 2.5rem 2rem;
		}
		.hero-carousel {
			position: relative;
			width: 100%;
			overflow: hidden;
		}
		.hero-track {
			display: flex;
			transition: transform 0.4s ease;
		}
		.hero-slide {
			flex: 0 0 100%;
			display: flex;
			flex-direction: column;
			justify-content: center;
			background: linear-gradient(135deg, #242B26, #2E362F);
			padding: 10rem 10vw 5rem;
			min-height: 100vh;
			text-decoration: none;
			color: var(--text);
			box-sizing: border-box;
		}
		.hero-slide:nth-child(1) {
			background:
				linear-gradient(rgba(27, 33, 29, 0.65), rgba(27, 33, 29, 0.65)),
				url('/forum-bg.png');
			background-size: cover;
			background-position: center;
		}
		.hero-slide:nth-child(2) {
			background:
				linear-gradient(rgba(27, 33, 29, 0.55), rgba(27, 33, 29, 0.55)),
				url('/assembly-bg.png');
			background-size: cover;
			background-position: center;
		}
		.hero-label {
			color: var(--yellow);
			font-size: 0.9rem;
			font-weight: 600;
			margin: 0 0 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}
		.hero-slide h2 {
			margin: 0 0 0.75rem;
			font-size: 2.25rem;
			color: var(--text);
		}
		.hero-date {
			color: var(--text-muted);
			margin: 0 0 1.5rem;
			font-size: 1.1rem;
		}
		.hero-cta {
			color: var(--yellow);
			font-weight: 600;
			font-size: 1rem;
		}
		.hero-arrow {
			position: absolute;
			top: 55%;
			transform: translateY(-50%);
			background: rgba(0, 0, 0, 0.4);
			color: var(--text);
			border: none;
			border-radius: 50%;
			width: 44px;
			height: 44px;
			font-size: 1.5rem;
			cursor: pointer;
			line-height: 1;
		}
		.hero-prev { left: 2rem; }
		.hero-next { right: 2rem; }
		.hero-dots {
			position: absolute;
			bottom: 1.5rem;
			left: 50%;
			transform: translateX(-50%);
			display: flex;
			gap: 0.5rem;
		}
		.hero-dot {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: rgba(255, 255, 255, 0.3);
			border: none;
			cursor: pointer;
			padding: 0;
		}
		.hero-dot.active {
			background: var(--yellow);
		}
		.category-preview-grid {
			display: grid;
			grid-template-columns: repeat(4, 1fr);
			gap: 1rem;
			margin: 1rem 0;
		}
		.category-preview-card {
			display: flex;
			align-items: flex-end;
			padding: 1.5rem 1rem;
			border-radius: 12px;
			text-decoration: none;
			font-weight: 700;
			font-size: 1.1rem;
			color: #FFFFFF;
			background-size: cover;
			background-position: center;
			min-height: 140px;
			transition: transform 0.2s;
		}
		.category-preview-card:hover {
			transform: translateY(-2px);
		}
		.member-preview-grid {
			display: grid;
			grid-template-columns: repeat(5, 1fr);
			gap: 1rem;
			margin: 1rem 0;
		}
		.member-preview-item {
			text-align: center;
		}
		.member-photo {
			width: 72px;
			height: 72px;
			border-radius: 50%;
			object-fit: cover;
			display: block;
			margin: 0 auto 0.5rem;
		}
		.member-name {
			font-size: 0.9rem;
			color: var(--card-text);
			margin: 0;
		}
	</style>

	<script>
		const track = document.getElementById('hero-track');
		const dots = document.querySelectorAll('.hero-dot');
		const prevBtn = document.getElementById('hero-prev');
		const nextBtn = document.getElementById('hero-next');
		let current = 0;
		const total = dots.length;

		function goTo(index) {
			current = (index + total) % total;
			track.style.transform = `translateX(-${current * 100}%)`;
			dots.forEach((dot, i) => dot.classList.toggle('active', i === current));
		}

		prevBtn.addEventListener('click', () => goTo(current - 1));
		nextBtn.addEventListener('click', () => goTo(current + 1));
		dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

		goTo(0);
	</script>
</Layout>