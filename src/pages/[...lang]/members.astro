---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl } from '../../i18n/ui';
import { anyEnName } from '../../i18n/people';

export function getStaticPaths() {
	return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}

const lang = getLangFromUrl(Astro.url);

const officersZh = [
	{ name: "關貫之", title: "理事長" },
	{ name: "謝至亮", title: "常務理事" },
	{ name: "尉遲和妘", title: "常務理事", link: "https://hoyunyuchih.github.io/#intro" },
	{ name: "顧廣毅", title: "理事" },
	{ name: "邱俊禕", title: "理事" },
	{ name: "莊宇權", title: "理事" },
	{ name: "胡芳碩", title: "理事" },
	{ name: "鄂禹臻", title: "理事" },
	{ name: "王浩平", title: "理事" },
	{ name: "施鈞瀚", title: "監事" },
	{ name: "廖士宏", title: "監事" },
	{ name: "柳鈞元", title: "監事" }
];

const secretaryZh = [
	{ name: "邱奕寧", title: "秘書長" }
];

const titleEn = {
	"理事長": "Chair of the Board",
	"常務理事": "Executive Director",
	"理事": "Director",
	"監事": "Supervisor",
	"秘書長": "Secretary-General",
	"會員": "Member"
};

const localize = (m) => ({
	link: m.link,
	name: lang === 'en' ? (anyEnName(m.name) || m.name) : m.name,
	title: lang === 'en' ? (titleEn[m.title] || m.title) : m.title
});

const officers = officersZh.map(localize);
const secretary = secretaryZh.map(localize);

const content = {
	zh: { pageTitle: '協會成員', officersHeading: '第一屆理監事成員', secretaryHeading: '秘書' },
	en: { pageTitle: 'Our Members', officersHeading: 'Members of the 1st Board of Directors and Board of Supervisors', secretaryHeading: 'Secretary' }
};
const c = content[lang];
---

<Layout title={c.pageTitle}>
	<div class="panel">
		<div class="panel-inner">
			<section>
				<h2>{c.officersHeading}</h2>
				<div class="member-card-grid">
					{officers.map((m) => (
						<div class="member-mini-card">
							<p class="member-name">{m.link ? <a href={m.link} target="_blank" rel="noopener noreferrer">{m.name}</a> : m.name}</p>
							<p class="member-title">{m.title}</p>
						</div>
					))}
				</div>
			</section>

			<section class="second-section">
				<h2>{c.secretaryHeading}</h2>
				<div class="member-card-grid">
					{secretary.map((m) => (
						<div class="member-mini-card">
							<p class="member-name">{m.link ? <a href={m.link} target="_blank" rel="noopener noreferrer">{m.name}</a> : m.name}</p>
							<p class="member-title">{m.title}</p>
						</div>
					))}
				</div>
			</section>
		</div>
	</div>

	<style>
		.panel {
			background: var(--panel-bg);
			color: var(--card-text);
			padding-top: var(--header-h, 90px);
		}
		.panel h1, .panel h2, .panel h3 {
			color: var(--card-text);
		}
		.panel-inner {
			max-width: 800px;
			margin: 0 auto;
			padding: 2.5rem 2rem;
		}
		.second-section {
			margin-top: 2.5rem;
			padding-top: 1.5rem;
			border-top: 1px solid #DDD2BE;
		}
		.member-card-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
			gap: 0.75rem;
			margin-top: 1rem;
		}
		.member-mini-card {
			background: var(--card-bg);
			color: var(--card-text);
			border-radius: 10px;
			padding: 0.9rem 0.5rem;
			text-align: center;
		}
		.member-mini-card .member-name {
			margin: 0 0 0.2rem;
			font-size: 0.9rem;
			font-weight: 600;
		}
		.member-mini-card .member-name a {
			color: inherit;
			text-decoration: underline;
			text-decoration-color: var(--orange);
			text-underline-offset: 3px;
		}
		.member-mini-card .member-name a:hover {
			color: var(--orange);
		}
		.member-mini-card .member-title {
			margin: 0;
			font-size: 0.75rem;
			color: var(--orange);
		}
	</style>
</Layout>
